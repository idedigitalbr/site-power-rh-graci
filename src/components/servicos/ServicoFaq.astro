---
// ServicoFaq.astro — Acordeão de perguntas frequentes específico de cada serviço
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import type { FaqItem } from '../../data/siteContent';

interface Props {
  faq: {
    eyebrow: string;
    title: string;
    items: FaqItem[];
  };
  serviceTitle: string;
}

const { faq, serviceTitle } = Astro.props;
---

<section class="section-servico-faq" id="faq-servico">
  <Container size="wide">
    <SectionHeader
      eyebrow={faq.eyebrow}
      title={faq.title}
      center={true}
    />

    <div class="servico-faq-layout">
      <!-- Lista do Acordeão Oficial -->
      <div class="faq-list-final">
        {faq.items.map((item, index) => (
          <div class={`faq-item-final ${item.isOpenDefault || index === 0 ? 'active' : ''}`.trim()}>
            <button
              type="button"
              class="faq-btn-trigger"
              aria-expanded={item.isOpenDefault || index === 0 ? 'true' : 'false'}
            >
              <span class="faq-question-text">{item.question}</span>
              <span class="faq-icon-chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="faq-answer-panel">
              <p class="faq-answer-text">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Caixa Lateral de Dúvidas Diretas -->
      <div class="faq-help-aside">
        <div class="help-card-inner">
          <div class="help-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C88A3B" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <h3 class="help-card-title">Tem uma dúvida específica sobre {serviceTitle}?</h3>
          <p class="help-card-desc">
            Cada empresa tem suas particularidades. Converse diretamente com Graciete Corrêa para entender a viabilidade do seu caso.
          </p>
          <Button
            href={`https://wa.me/5591992992091?text=${encodeURIComponent(`Olá Graciete, tenho uma dúvida sobre a solução de ${serviceTitle}`)}`}
            variant="gold"
            whatsapp={true}
            class="w-full text-center flex items-center justify-center"
          >
            TIRAR DÚVIDA NO WHATSAPP
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .section-servico-faq {
    position: relative;
    padding: 100px 0 105px;
    background-color: var(--color-bg-warm, #FCFAF7);
    border-bottom: 1px solid rgba(200, 138, 59, 0.15);
  }

  .servico-faq-layout {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 40px;
    margin-top: 50px;
    align-items: start;
  }

  @media (max-width: 991px) {
    .servico-faq-layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .faq-list-final {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item-final {
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid rgba(1, 36, 62, 0.08);
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .faq-item-final.active {
    border-color: rgba(200, 138, 59, 0.4);
    box-shadow: 0 8px 24px rgba(1, 36, 62, 0.06);
  }

  .faq-btn-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 24px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: var(--color-navy-deep, #01243E);
    transition: color 0.2s ease;
  }

  .faq-btn-trigger:hover {
    color: var(--color-gold-hover, #B07427);
  }

  .faq-question-text {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
  }

  .faq-icon-chevron {
    color: var(--color-gold, #C88A3B);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .faq-item-final.active .faq-icon-chevron {
    transform: rotate(180deg);
  }

  .faq-answer-panel {
    display: none;
    padding: 0 24px 22px;
  }

  .faq-item-final.active .faq-answer-panel {
    display: block;
  }

  .faq-answer-text {
    font-size: 14.5px;
    color: #4A5568;
    line-height: 1.65;
    margin: 0;
  }

  /* Aside de Ajuda */
  .faq-help-aside {
    position: sticky;
    top: 100px;
  }

  .help-card-inner {
    background: #01243E;
    border-radius: 24px;
    padding: 34px 28px;
    color: #FFFFFF;
    border: 1px solid rgba(200, 138, 59, 0.3);
    box-shadow: 0 16px 40px rgba(1, 36, 62, 0.2);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .help-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(200, 138, 59, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .help-card-title {
    font-size: 19px;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.3;
    margin: 0;
  }

  .help-card-desc {
    font-size: 14px;
    color: #A3B8CC;
    line-height: 1.55;
    margin: 0 0 8px;
  }
</style>
