---
// ServicoMetodo.astro — A metodologia estruturada em 4 etapas práticas
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import type { ServiceMethodStep } from '../../data/siteContent';

interface Props {
  method: {
    eyebrow: string;
    title: string;
    subtitle: string;
    steps: ServiceMethodStep[];
  };
}

const { method } = Astro.props;
---

<section class="section-servico-metodo" id="metodologia">
  <Container size="wide">
    <SectionHeader
      eyebrow={method.eyebrow}
      title={method.title}
      subtitle={method.subtitle}
      center={true}
    />

    <div class="servico-metodo-timeline">
      <div class="timeline-line-track" aria-hidden="true"></div>

      <div class="metodo-steps-grid">
        {method.steps.map((item) => (
          <div class="metodo-step-card">
            <div class="step-badge-circle">
              <span class="step-num">{item.step}</span>
            </div>

            <div class="step-tag-pill">{item.tag}</div>
            <h3 class="step-card-title">{item.title}</h3>
            <p class="step-card-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

<style>
  .section-servico-metodo {
    position: relative;
    padding: 100px 0 105px;
    background-color: var(--color-bg-warm, #FCFAF7);
    border-bottom: 1px solid rgba(200, 138, 59, 0.15);
  }

  .servico-metodo-timeline {
    position: relative;
    margin-top: 60px;
  }

  .timeline-line-track {
    position: absolute;
    top: 36px;
    left: 8%;
    right: 8%;
    height: 2px;
    background: linear-gradient(90deg, rgba(200, 138, 59, 0.2), #C88A3B 50%, rgba(200, 138, 59, 0.2));
    z-index: 1;
  }

  .metodo-steps-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  @media (max-width: 991px) {
    .timeline-line-track {
      display: none;
    }

    .metodo-steps-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .metodo-steps-grid {
      grid-template-columns: 1fr;
    }
  }

  .metodo-step-card {
    background: #FFFFFF;
    border-radius: 20px;
    padding: 28px 22px;
    border: 1px solid rgba(1, 36, 62, 0.08);
    box-shadow: 0 4px 18px rgba(1, 36, 62, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;
  }

  .metodo-step-card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 138, 59, 0.4);
    box-shadow: 0 16px 32px rgba(1, 36, 62, 0.08);
  }

  .step-badge-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #01243E;
    border: 2px solid #C88A3B;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    box-shadow: 0 4px 12px rgba(1, 36, 62, 0.2);
  }

  .step-num {
    font-size: 19px;
    font-weight: 800;
    color: #ECC78A;
    font-family: var(--font-mono, monospace);
  }

  .step-tag-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 9999px;
    background: var(--color-gold-light, #FDF6EC);
    color: var(--color-gold-dark, #9A621D);
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .step-card-title {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--color-navy-deep, #01243E);
    line-height: 1.35;
    margin: 0 0 10px;
  }

  .step-card-desc {
    font-size: 13.5px;
    color: #4A5568;
    line-height: 1.55;
    margin: 0;
  }
</style>
