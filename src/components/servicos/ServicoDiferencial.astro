---
// ServicoDiferencial.astro — Seção executiva de autoridade da fundadora Graciete Corrêa
import Container from '../ui/Container.astro';
import GoldenArcs from '../ui/GoldenArcs.astro';
import type { ServiceDifferentialItem } from '../../data/siteContent';

interface Props {
  differential: {
    eyebrow: string;
    title: string;
    lead: string;
    quote: string;
    founderName: string;
    founderRole: string;
    image: string;
    pillars: ServiceDifferentialItem[];
  };
}

const { differential } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-servico-diferencial" id="diferencial-autoridade">
  <!-- Arcos Dourados Finos de Fundo -->
  <GoldenArcs position="left" variant="arcs-left" />

  <Container size="wide">
    <div class="servico-diferencial-layout">
      <!-- Coluna da Esquerda: Foto de Autoridade com Selo -->
      <div class="diferencial-photo-col">
        <div class="diferencial-photo-box">
          <img
            src={`${base}/${differential.image}`}
            alt={`${differential.founderName} — ${differential.founderRole}`}
            class="diferencial-photo-img"
            loading="lazy"
          />
          <div class="diferencial-photo-gradient"></div>

          <div class="diferencial-founder-tag">
            <strong class="tag-name">{differential.founderName}</strong>
            <span class="tag-role">{differential.founderRole}</span>
          </div>
        </div>
      </div>

      <!-- Coluna da Direita: Narrativa de Autoridade, Citação e Pilares -->
      <div class="diferencial-content-col">
        <span class="hero-eyebrow-final">{differential.eyebrow}</span>
        
        <h2 class="diferencial-heading-title">
          {differential.title}
        </h2>

        <p class="diferencial-lead-copy">
          {differential.lead}
        </p>

        <!-- Bloco de Citação Marcante -->
        <blockquote class="diferencial-quote-box">
          <div class="quote-symbol">“</div>
          <p class="quote-text">{differential.quote}</p>
        </blockquote>

        <!-- 3 Pilares de Autoridade da Solução -->
        <div class="diferencial-pillars-list">
          {differential.pillars.map((pillar) => (
            <div class="pillar-row-item">
              <div class="pillar-icon-gold">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C88A3B" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="pillar-text-group">
                <h3 class="pillar-title">{pillar.title}</h3>
                <p class="pillar-desc">{pillar.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .section-servico-diferencial {
    position: relative;
    padding: 105px 0 110px;
    background: radial-gradient(circle at 80% 20%, #0E2934 0%, #081624 60%, #01243E 100%);
    color: #FFFFFF;
    overflow: hidden;
  }

  .servico-diferencial-layout {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 56px;
    align-items: center;
  }

  @media (max-width: 991px) {
    .servico-diferencial-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* Coluna da Foto */
  .diferencial-photo-col {
    display: flex;
    justify-content: center;
  }

  .diferencial-photo-box {
    position: relative;
    width: 100%;
    max-width: 420px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(200, 138, 59, 0.35);
    background: #01243E;
    aspect-ratio: 4 / 5.2;
  }

  .diferencial-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .diferencial-photo-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(1, 36, 62, 0.95) 100%);
    pointer-events: none;
  }

  .diferencial-founder-tag {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(8, 22, 36, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(200, 138, 59, 0.3);
    border-radius: 14px;
    padding: 12px 18px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .tag-name {
    font-size: 15px;
    color: #FFFFFF;
    font-weight: 700;
  }

  .tag-role {
    font-size: 11.5px;
    color: #ECC78A;
  }

  /* Coluna do Conteúdo */
  .diferencial-content-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .diferencial-heading-title {
    font-size: clamp(24px, 2.8vw, 34px);
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.22;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .diferencial-lead-copy {
    font-size: 15.5px;
    color: #CBD5E1;
    line-height: 1.65;
    margin: 0;
  }

  .diferencial-quote-box {
    position: relative;
    background: rgba(255, 255, 255, 0.04);
    border-left: 3px solid var(--color-gold, #C88A3B);
    padding: 16px 20px 16px 24px;
    border-radius: 0 14px 14px 0;
    margin: 4px 0;
  }

  .quote-symbol {
    position: absolute;
    top: -10px;
    right: 18px;
    font-size: 48px;
    color: rgba(200, 138, 59, 0.18);
    font-family: serif;
    line-height: 1;
    pointer-events: none;
  }

  .quote-text {
    font-size: 14.5px;
    font-style: italic;
    color: #F1F5F9;
    line-height: 1.6;
    margin: 0;
  }

  .diferencial-pillars-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 10px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
  }

  .pillar-row-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .pillar-icon-gold {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(200, 138, 59, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pillar-text-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pillar-title {
    font-size: 15.5px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .pillar-desc {
    font-size: 13.5px;
    color: #94A3B8;
    line-height: 1.5;
    margin: 0;
  }
</style>
