---
// ServicosHubCards.astro — Grid editorial das 4 soluções estratégicas da PowerRH
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import type { ServicosHubData } from '../../data/siteContent';

interface Props {
  hubData: ServicosHubData;
}

const { hubData } = Astro.props;
const { intro, cards } = hubData;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-hub-cards" id="grade-solucoes">
  <Container size="wide">
    <SectionHeader
      eyebrow={intro.eyebrow}
      title={intro.title}
      subtitle={intro.subtitle}
      center={true}
    />

    <div class="hub-editorial-cards-grid">
      {cards.map((card) => (
        <article class="hub-editorial-card">
          <!-- Imagem Executiva com Aspect Ratio Impecável -->
          <div class="hub-card-photo-box">
            <img
              src={`${base}/${card.image}`}
              alt={card.title}
              class="hub-card-photo-img"
              loading="lazy"
            />
            <div class="hub-card-number-badge">{card.number}</div>
          </div>

          <!-- Conteúdo Enxuto & Sofisticado -->
          <div class="hub-card-info-box">
            <span class="hub-card-category">{card.category}</span>
            <h3 class="hub-card-title">{card.title}</h3>
            <p class="hub-card-desc">{card.desc}</p>

            <!-- Tags Rápidas de Entrega (Apenas 3 para não poluir) -->
            <div class="hub-card-tags-row">
              {card.highlights.slice(0, 3).map((hl) => (
                <span class="hub-tag-chip">{hl}</span>
              ))}
            </div>

            <div class="hub-card-action">
              <Button
                href={`${base}/servicos/${card.slug}`}
                variant="gold"
                class="w-full text-center flex items-center justify-center py-3.5"
              >
                Conhecer esta solução →
              </Button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  .section-hub-cards {
    position: relative;
    padding: 100px 0 110px;
    background-color: var(--color-bg-warm, #FAF7F2);
  }

  .hub-editorial-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 36px;
    margin-top: 54px;
  }

  @media (max-width: 991px) {
    .hub-editorial-cards-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .hub-editorial-card {
    background: #FFFFFF;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(1, 36, 62, 0.08);
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(1, 36, 62, 0.04);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .hub-editorial-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 45px rgba(1, 36, 62, 0.10);
    border-color: rgba(200, 138, 59, 0.4);
  }

  .hub-card-photo-box {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: #01243E;
  }

  .hub-card-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    transition: transform 0.6s ease;
  }

  .hub-editorial-card:hover .hub-card-photo-img {
    transform: scale(1.04);
  }

  .hub-card-number-badge {
    position: absolute;
    top: 18px;
    left: 20px;
    background: rgba(1, 36, 62, 0.90);
    backdrop-filter: blur(8px);
    color: var(--color-gold, #C88A3B);
    font-size: 13px;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(200, 138, 59, 0.4);
  }

  .hub-card-info-box {
    padding: 34px 30px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .hub-card-category {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    color: var(--color-gold, #C88A3B);
    text-transform: uppercase;
    font-family: var(--font-mono, monospace);
    display: block;
    margin-bottom: 8px;
  }

  .hub-card-title {
    font-size: clamp(21px, 1.8vw, 24px);
    font-weight: 800;
    color: var(--color-navy-deep, #01243E);
    line-height: 1.25;
    margin: 0 0 12px;
    letter-spacing: -0.015em;
  }

  .hub-card-desc {
    font-size: 14.5px;
    color: #4A5568;
    line-height: 1.6;
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .hub-card-tags-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(1, 36, 62, 0.08);
  }

  .hub-tag-chip {
    font-size: 13px;
    color: #334155;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hub-tag-chip::before {
    content: '•';
    color: var(--color-gold, #C88A3B);
    font-size: 16px;
    line-height: 1;
  }

  .hub-card-action {
    margin-top: auto;
  }
</style>
