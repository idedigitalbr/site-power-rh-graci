---
// ServicoHero.astro — Topo executivo editorial para páginas de serviço PowerRH
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import GoldenArcs from '../ui/GoldenArcs.astro';
import type { ServiceDetail } from '../../data/siteContent';

interface Props {
  service: ServiceDetail;
}

const { service } = Astro.props;
const { hero } = service;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero-final-section servico-hero-custom" id="inicio-servico">
  <!-- Camada de Fundo Panorâmica Executiva -->
  <div class="hero-bg-media-layer" aria-hidden="true">
    <div class="servico-hero-glow"></div>
    <div class="hero-bg-media-gradient"></div>
  </div>

  <!-- Arcos Dourados Finos da Marca -->
  <GoldenArcs position="right" variant="arcs-right" />

  <Container size="wide" class="hero-container-relative">
    <div class="servico-hero-grid">
      <!-- Coluna 1: Copywriting, Headline e Badges Oficiais -->
      <div class="servico-hero-copy">
        <div class="servico-hero-badge-wrap">
          <span class="hero-eyebrow-final">{service.eyebrow}</span>
          <span class="servico-category-chip">{service.category}</span>
        </div>

        <h1 class="hero-title-final">
          {hero.titlePrefix}{' '}
          <span class="highlight-gold">{hero.titleHighlight}</span>{' '}
          {hero.titleSuffix}
        </h1>

        <p class="hero-subtitle-final">
          {hero.lead}
        </p>

        <!-- Ações Primária & Secundária -->
        <div class="hero-cta-group">
          <Button href={hero.ctaHref} variant="hero-pill" whatsapp={true}>
            {hero.ctaText}
          </Button>
          <Button href="#escopo-modulos" variant="secondary">
            Ver escopo & módulos ↓
          </Button>
        </div>

        <!-- Pills de Escopo Rápido -->
        <div class="servico-pills-row" aria-label="Especialidades inclusas">
          {hero.pills.map((pill) => (
            <span class="servico-scope-pill">
              <span class="scope-pill-dot" aria-hidden="true"></span>
              {pill}
            </span>
          ))}
        </div>
      </div>

      <!-- Coluna 2: Card Fotográfico com Moldura Dourada e Selo Flutuante -->
      <div class="servico-hero-media">
        <div class="servico-photo-card-wrapper">
          <div class="servico-photo-frame">
            <img
              src={`${base}/${hero.image}`}
              alt={`${service.shortTitle} — PowerRH Consultoria Estratégica`}
              class="servico-photo-img"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <div class="servico-photo-overlay"></div>
          </div>

          <!-- Selo Flutuante Executivo -->
          <div class="servico-floating-seal">
            <div class="seal-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C88A3B" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="seal-text">
              <span class="seal-badge-sub">MÉTODO POWERRH</span>
              <strong class="seal-badge-title">{hero.floatingBadge}</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .servico-hero-custom {
    position: relative;
    padding: 140px 0 90px;
    background: radial-gradient(circle at 18% 25%, #0B253A 0%, #061524 75%, #020B13 100%);
    overflow: hidden;
    min-height: 82vh;
    display: flex;
    align-items: center;
  }

  .servico-hero-glow {
    position: absolute;
    top: 15%;
    left: 8%;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(200, 138, 59, 0.16) 0%, rgba(1, 36, 62, 0) 70%);
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
  }

  .servico-hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .servico-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .servico-hero-badge-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .servico-category-chip {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 9999px;
    background: rgba(200, 138, 59, 0.15);
    border: 1px solid rgba(200, 138, 59, 0.35);
    color: #ECC78A;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: var(--font-mono, monospace);
  }

  .hero-title-final {
    color: #FFFFFF;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .highlight-gold {
    color: var(--color-gold, #C88A3B);
    background: linear-gradient(135deg, #ECC78A 0%, #C88A3B 50%, #B07427 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle-final {
    color: #A7B8C7;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.55;
    margin: 0;
    max-width: 580px;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .servico-pills-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .servico-scope-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    color: #E2EBF2;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    padding: 6px 14px;
    border-radius: 9999px;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .servico-scope-pill:hover {
    border-color: rgba(200, 138, 59, 0.45);
    background: rgba(200, 138, 59, 0.08);
    color: #FFFFFF;
  }

  .scope-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-gold, #C88A3B);
    display: inline-block;
  }

  /* Coluna da Imagem */
  .servico-hero-media {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .servico-photo-card-wrapper {
    position: relative;
    width: 100%;
    max-width: 440px;
  }

  .servico-photo-frame {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4 / 4.8;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(200, 138, 59, 0.25);
    background: #0B253A;
  }

  .servico-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .servico-photo-card-wrapper:hover .servico-photo-img {
    transform: scale(1.03);
  }

  .servico-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(1, 36, 62, 0) 50%, rgba(1, 36, 62, 0.75) 100%);
    pointer-events: none;
  }

  .servico-floating-seal {
    position: absolute;
    bottom: -18px;
    left: 20px;
    right: 20px;
    background: rgba(9, 34, 56, 0.92);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(200, 138, 59, 0.4);
    border-radius: 16px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
  }

  .seal-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(200, 138, 59, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .seal-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .seal-badge-sub {
    font-size: 10px;
    color: #ECC78A;
    letter-spacing: 0.10em;
    font-weight: 700;
    text-transform: uppercase;
  }

  .seal-badge-title {
    font-size: 13px;
    color: #FFFFFF;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 991px) {
    .servico-hero-custom {
      padding: 120px 0 70px;
      min-height: auto;
    }

    .servico-hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .servico-hero-media {
      order: -1;
    }

    .servico-photo-card-wrapper {
      max-width: 360px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .hero-cta-group {
      flex-direction: column;
      align-items: stretch;
    }

    .servico-floating-seal {
      position: static;
      margin-top: 14px;
    }
  }
</style>
