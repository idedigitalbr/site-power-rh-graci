---
// ServicoHero.astro — Hero panorâmico executivo oficial com contraste impecável
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import GoldenArcs from '../ui/GoldenArcs.astro';
import type { ServiceDetail } from '../../data/siteContent';

interface Props {
  service: ServiceDetail;
}

const { service } = Astro.props;
const { hero } = service;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero-final-section servico-hero-custom" id="inicio-servico">
  <!-- Camada de Imagem Panorâmica em Fundo com Gradiente Oficial (Branco à esquerda, foto à direita) -->
  <div class="hero-bg-media-layer" aria-hidden="true">
    <img
      src={`${base}/${hero.image}`}
      alt={`${service.shortTitle} — PowerRH Consultoria Estratégica`}
      class="hero-bg-media-img is-active"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-bg-media-gradient"></div>
  </div>

  <!-- Arcos Dourados Finos da Marca na margem direita -->
  <GoldenArcs position="right" variant="arcs-right" />

  <Container size="wide" class="hero-container-relative">
    <div class="hero-panoramic-layout">
      <!-- Coluna Principal: Tipografia de Alto Contraste (Navy #0A1C2E e Ouro #C48D47) -->
      <div class="hero-copy-box">
        <span class="hero-eyebrow-final">{service.eyebrow}</span>

        <h1 class="hero-title-final">
          {hero.titlePrefix}<br />
          <span class="highlight-gold">{hero.titleHighlight}</span><br />
          {hero.titleSuffix}
        </h1>

        <p class="hero-subtitle-final">
          {hero.lead}
        </p>

        <!-- CTA Principal Header -->
        <div class="hero-cta-group">
          <Button href={hero.ctaHref} variant="hero-pill" whatsapp={true}>
            {hero.ctaText}
          </Button>
          <Button href="#frente-editorial" variant="secondary">
            Conhecer atuação ↓
          </Button>
        </div>

        <!-- Mini-Badges de Benefícios Rápidos com Ícones Dourados (Padrão Home) -->
        <div class="hero-mini-badges-row">
          {hero.pills.slice(0, 3).map((pill) => (
            <div class="hero-mini-badge-item">
              <div class="mini-badge-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C48D47" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <div class="mini-badge-text">
                <span>{pill}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Card Lateral Executivo de Propósito (Idêntico ao padrão SobreHero) -->
      <div class="servico-hero-card-col">
        <div class="servico-hero-quote-card">
          <div class="quote-card-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>{service.category}</span>
          </div>

          <p class="quote-card-text">
            “{hero.floatingBadge}”
          </p>

          <div class="quote-card-footer">
            <div class="quote-card-author">
              <strong>Graciete Corrêa</strong>
              <span>30+ anos de Liderança Executiva • PowerRH</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .servico-hero-custom {
    min-height: clamp(540px, 72vh, 680px);
    background-color: #FFFFFF;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .servico-hero-card-col {
    margin-left: auto;
    z-index: 3;
    display: flex;
    align-items: center;
  }

  @media (max-width: 991px) {
    .servico-hero-card-col {
      margin-left: 0;
      margin-top: 32px;
      width: 100%;
    }
    .hero-cta-group {
      justify-content: center;
    }
  }

  .servico-hero-quote-card {
    background: rgba(1, 36, 62, 0.88);
    border: 1px solid rgba(200, 138, 59, 0.35);
    border-radius: 20px;
    padding: 32px 28px;
    max-width: 380px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.35), 0 0 20px rgba(200, 138, 59, 0.12);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .quote-card-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--final-gold, #C88A3B);
    text-transform: uppercase;
    font-family: var(--font-mono, monospace);
  }

  .quote-card-text {
    font-size: 15.5px;
    line-height: 1.55;
    color: #F8FAFC;
    font-weight: 600;
    font-style: italic;
    margin: 0;
  }

  .quote-card-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 14px;
  }

  .quote-card-author {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .quote-card-author strong {
    font-size: 14px;
    color: #FFFFFF;
    font-weight: 700;
  }

  .quote-card-author span {
    font-size: 12px;
    color: #94A3B8;
  }
</style>
