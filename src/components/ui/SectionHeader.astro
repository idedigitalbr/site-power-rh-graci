---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  center = true,
  class: className = '',
} = Astro.props;
---

<div class={`section-header-block ${center ? 'text-center' : ''} ${className}`.trim()}>
  {eyebrow && (
    center ? (
      <div class="section-eyebrow-divider">
        <span>{eyebrow}</span>
      </div>
    ) : (
      <span class="hero-eyebrow-final" style="margin-bottom: 4px; display: inline-block;">
        {eyebrow}
      </span>
    )
  )}
  
  <h2 class={center ? 'section-title-center-final' : 'processo-title-final'}>
    {title}
  </h2>

  {subtitle && (
    <p class="section-subtitle" style="max-width: 680px; margin: 12px auto 0;">
      {subtitle}
    </p>
  )}
</div>
