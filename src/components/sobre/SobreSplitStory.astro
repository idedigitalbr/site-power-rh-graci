---
// SobreSplitStory.astro — S2 SOBREZINHA (Identidade Visual 100% Unificada com a Home da PowerRH)
import Container from '../ui/Container.astro';
import GoldenArcs from '../ui/GoldenArcs.astro';
import { siteContent } from '../../data/siteContent';

const { sobrePage } = siteContent;
const { historia } = sobrePage;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-sobre-final" id="sobre-historia">
  <!-- Arcos Dourados Finos Orgânicos na margem direita (Padrão Home S6) -->
  <GoldenArcs position="right" variant="arcs-right" />

  <Container size="wide">
    <div class="sobre-grid-final sobre-story-grid">
      <!-- Coluna Esquerda: Foto Oficial em Poltrona Executiva + Citação Editorial -->
      <div class="sobre-photo-container">
        <div class="sobre-img-box">
          <img
            src={`${base}/${historia.image}`}
            alt={`${historia.founderName} — ${historia.founderRole}`}
            class="sobre-photo-final"
            loading="lazy"
          />
        </div>

        <blockquote class="sobre-story-quote">
          <span class="sobre-quote-mark" aria-hidden="true">“</span>
          <p class="sobre-quote-text">{historia.quote}</p>
          <footer class="sobre-quote-footer">
            <strong>{historia.founderName}</strong> · Advisor especialista em estratégia de negócios e pessoas
          </footer>
        </blockquote>
      </div>

      <!-- Coluna Direita: Conteúdo Biográfico, Credenciais & Indicadores Oficiais -->
      <div class="sobre-details-col">
        <span class="hero-eyebrow-final" style="margin-bottom: 4px;">{historia.eyebrow}</span>
        <h2 class="sobre-name-final">{historia.founderName}</h2>
        <span class="sobre-subtitle-gold">+30 ANOS DE EXPERIÊNCIA E TRANSFORMAÇÃO CORPORATIVA</span>

        <p class="sobre-bio-text sobre-bio-lead">
          {historia.paragraphs[0]}
        </p>

        {historia.paragraphs.length > 1 && (
          <div class="bio-expandable-wrap" data-bio-accordion>
            <div class="bio-expandable-panel" id="sobre-bio-extra" role="region">
              <div class="bio-expandable-inner">
                {historia.paragraphs.slice(1).map((paragraph) => (
                  <p class="sobre-bio-text sobre-bio-extra-p">
                    {paragraph}
                  </p>
                ))}
              </div>
            </div>

            <button
              type="button"
              class="bio-toggle-btn"
              aria-expanded="false"
              aria-controls="sobre-bio-extra"
              data-bio-toggle
            >
              <span data-bio-label>Ver mais sobre a trajetória</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
          </div>
        )}

        <!-- 4 Credenciais com Ícones Dourados Circulares (Exato S6 Sobre da Home) -->
        <div class="sobre-credentials-list">
          {historia.credentials.map((cred) => (
            <div class="credential-item-final">
              <div class="credential-icon-circle">
                {cred.iconType === 'cert' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                )}
                {cred.iconType === 'mentor' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="7" r="4"></circle>
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  </svg>
                )}
                {cred.iconType === 'industry' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                )}
                {cred.iconType === 'star' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                )}
              </div>
              <span class="credential-text-final">{cred.text}</span>
            </div>
          ))}
        </div>

        <!-- Indicadores / KPIs Consolidados com a ID Visual de Métricas da Home -->
        <div class="sobre-metrics-bar">
          <div class="sobre-metric-box">
            <span class="sobre-metric-num">+30</span>
            <span class="sobre-metric-lbl">ANOS DE EXPERIÊNCIA EXECUTIVA</span>
          </div>
          <div class="sobre-metric-box">
            <span class="sobre-metric-num">+2.000</span>
            <span class="sobre-metric-lbl">COLABORADORES SOB GESTÃO</span>
          </div>
          <div class="sobre-metric-box">
            <span class="sobre-metric-num">+2</span>
            <span class="sobre-metric-lbl">OPERAÇÕES DE M&amp;A ESTRUTURADAS</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script is:inline>
  (() => {
    const initBioExpanders = () => {
      const toggles = document.querySelectorAll('[data-bio-toggle]');
      toggles.forEach((btn) => {
        if (btn.dataset.initialized === 'true') return;
        btn.dataset.initialized = 'true';

        btn.addEventListener('click', () => {
          const wrap = btn.closest('[data-bio-accordion]');
          const panel = wrap?.querySelector('.bio-expandable-panel');
          const label = btn.querySelector('[data-bio-label]');
          const isOpen = btn.getAttribute('aria-expanded') === 'true';

          if (isOpen) {
            btn.setAttribute('aria-expanded', 'false');
            btn.classList.remove('is-open');
            panel?.classList.remove('is-open');
            if (label) label.textContent = 'Ver mais sobre a trajetória';
          } else {
            btn.setAttribute('aria-expanded', 'true');
            btn.classList.add('is-open');
            panel?.classList.add('is-open');
            if (label) label.textContent = 'Ver menos';
          }
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBioExpanders);
    } else {
      initBioExpanders();
    }
    document.addEventListener('astro:page-load', initBioExpanders);
  })();
</script>

<style>
  .sobre-story-grid {
    align-items: start;
  }

  .sobre-story-quote {
    margin: 20px 0 0;
    padding: 20px 22px;
    background: #FAF7F2;
    border: 1px solid #EDE7DD;
    border-left: 3px solid #C88A3B;
    border-radius: 16px;
    position: relative;
  }

  .sobre-quote-mark {
    display: block;
    font-family: Georgia, serif;
    font-size: 30px;
    line-height: 0.8;
    color: #C88A3B;
    margin-bottom: 6px;
  }

  .sobre-quote-text {
    font-size: 14px;
    line-height: 1.62;
    color: #334155;
    margin: 0 0 10px;
    font-style: italic;
  }

  .sobre-quote-footer {
    font-size: 12px;
    color: #64748B;
  }

  .sobre-quote-footer strong {
    color: #01243E;
    font-weight: 700;
  }

  .sobre-bio-lead {
    margin-bottom: 14px;
  }

  .bio-expandable-wrap {
    margin-bottom: 26px;
  }

  .bio-expandable-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.32s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.24s ease;
  }

  .bio-expandable-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .bio-expandable-inner {
    overflow: hidden;
  }

  .sobre-bio-extra-p {
    margin-bottom: 16px;
  }

  .bio-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FDF6EC;
    color: #9A621D;
    border: 1px solid rgba(200, 138, 59, 0.4);
    border-radius: 9999px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .bio-toggle-btn:hover {
    background: #C88A3B;
    color: #FFFFFF;
    border-color: #C88A3B;
  }

  .bio-toggle-btn svg {
    transition: transform 0.25s ease;
  }

  .bio-toggle-btn.is-open svg {
    transform: rotate(180deg);
  }

  .sobre-metrics-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--final-border-subtle, #EDE7DD);
  }

  @media (max-width: 640px) {
    .sobre-metrics-bar {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  .sobre-metric-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    background: #FCFAF7;
    border: 1px solid rgba(200, 138, 59, 0.2);
    border-radius: 12px;
    transition: all 250ms ease;
  }

  .sobre-metric-box:hover {
    background: #FFFFFF;
    border-color: rgba(200, 138, 59, 0.45);
    box-shadow: 0 4px 14px rgba(200, 138, 59, 0.12);
    transform: translateY(-2px);
  }

  .sobre-metric-num {
    font-size: 26px;
    font-weight: 800;
    color: var(--final-gold-dark, #9A621D);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .sobre-metric-lbl {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748B;
    line-height: 1.35;
  }
</style>
