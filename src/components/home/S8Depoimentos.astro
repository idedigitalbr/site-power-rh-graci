---
// S8Depoimentos.astro — Seção Depoimentos orientada a dados com cards e avatares
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { siteContent } from '../../data/siteContent';

const { depoimentos } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-depoimentos-final" id="depoimentos">
  <Container size="wide">
    <SectionHeader
      eyebrow={depoimentos.eyebrow}
      title={depoimentos.title}
      center={true}
    />

    <div class="depoimentos-grid-final">
      {depoimentos.items.map((card) => (
        <div class="depoimento-card-final">
          <div>
            <div class="depoimento-quote-mark">“</div>
            <p class="depoimento-text-final">{card.quote}</p>
          </div>
          <div class="depoimento-author-row">
            <img
              src={`${base}/${card.avatar}`}
              alt={card.author}
              class="depoimento-avatar-img"
              loading="lazy"
            />
            <div>
              <div class="depoimento-author-name">{card.author}</div>
              <div class="depoimento-author-role">{card.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
