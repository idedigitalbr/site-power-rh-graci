---
// S2Metrics.astro — Seção S2: Métricas de autoridade + Copy estratégico + Formulário de diagnóstico
import Container from '../ui/Container.astro';
import { siteContent } from '../../data/siteContent';

const { metrics, s2Consultoria } = siteContent;
---

<section class="section-s2-consultoria" id="formulario-diagnostico">
  <!-- Linhas decorativas orgânicas douradas no background à esquerda -->
  <div class="s2-bg-lines" aria-hidden="true">
    <svg viewBox="0 0 700 700" fill="none" xmlns="http://www.w3.org/2000/svg" class="s2-lines-svg">
      <ellipse cx="-40" cy="350" rx="420" ry="260" stroke="url(#gold-arc-1)" stroke-width="1.8" />
      <ellipse cx="-90" cy="350" rx="540" ry="340" stroke="url(#gold-arc-2)" stroke-width="1.4" />
      <ellipse cx="-140" cy="350" rx="660" ry="430" stroke="url(#gold-arc-3)" stroke-width="1.2" />
      <ellipse cx="-190" cy="350" rx="780" ry="520" stroke="url(#gold-arc-4)" stroke-width="1" />
      <defs>
        <linearGradient id="gold-arc-1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#C88A3B" stop-opacity="0.5" />
          <stop offset="65%" stop-color="#E2B777" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#FCFAF7" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="gold-arc-2" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#C88A3B" stop-opacity="0.38" />
          <stop offset="70%" stop-color="#E2B777" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#FCFAF7" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="gold-arc-3" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#C88A3B" stop-opacity="0.26" />
          <stop offset="80%" stop-color="#E2B777" stop-opacity="0.1" />
          <stop offset="100%" stop-color="#FCFAF7" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="gold-arc-4" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#C88A3B" stop-opacity="0.16" />
          <stop offset="100%" stop-color="#FCFAF7" stop-opacity="0" />
        </linearGradient>
      </defs>
    </svg>
  </div>

  <Container size="wide" class="s2-container-relative">
    <div class="s2-main-grid">
      <!-- ============================================================ -->
      <!-- COLUNA 1: GRID 2x2 DE CARDS DE MÉTRICAS                       -->
      <!-- ============================================================ -->
      <div class="s2-metrics-grid">
        {metrics.map((item) => (
          <div class="s2-metric-card">
            <div class="s2-metric-icon">
              {item.iconType === 'chart' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" color="#C88A3B">
                  <rect x="4" y="12" width="3.5" height="9" rx="1.75"></rect>
                  <rect x="10.25" y="3" width="3.5" height="18" rx="1.75"></rect>
                  <rect x="16.5" y="7.5" width="3.5" height="13.5" rx="1.75"></rect>
                </svg>
              )}
              {item.iconType === 'people' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#C88A3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              )}
              {item.iconType === 'handshake' && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#C88A3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-2.6-2.6a1 1 0 0 0-1.4 0L11 14.4"></path>
                  <path d="m3 11 4.5-4.5a2 2 0 0 1 2.8 0L14 10"></path>
                  <path d="m17 11 3.5-3.5a2 2 0 0 0 0-2.8l-1.2-1.2a2 2 0 0 0-2.8 0L13 7"></path>
                  <path d="m13 13 3.5 3.5"></path>
                  <path d="m2 17 3.5-3.5"></path>
                </svg>
              )}
              {item.iconType === 'star' && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#C88A3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              )}
            </div>
            <div class="s2-metric-number">{item.number}</div>
            <div class="s2-metric-label">{item.label}</div>
          </div>
        ))}
      </div>

      <!-- ============================================================ -->
      <!-- COLUNA 2: HEADLINE & COPY ESTRATÉGICO                         -->
      <!-- ============================================================ -->
      <div class="s2-copy-column">
        <span class="s2-eyebrow">{s2Consultoria.eyebrow}</span>
        <h2 class="s2-headline">
          {s2Consultoria.headlinePrefix}<br />
          {s2Consultoria.headlineMiddle}<br />
          <span class="s2-headline-highlight">{s2Consultoria.headlineHighlight}</span>
        </h2>
        <p class="s2-description">
          {s2Consultoria.description}
        </p>
      </div>

      <!-- ============================================================ -->
      <!-- COLUNA 3: FORMULÁRIO DE DIAGNÓSTICO (DARK NAVY CARD)          -->
      <!-- ============================================================ -->
      <div class="s2-form-column">
        <div class="s2-form-card">
          <div class="s2-form-header">
            <h3 class="s2-form-title">{s2Consultoria.form.title}</h3>
            <p class="s2-form-desc">{s2Consultoria.form.desc}</p>
          </div>

          <form
            action="#"
            method="POST"
            class="s2-form-fields"
            onsubmit="event.preventDefault(); alert('Solicitação de diagnóstico enviada com sucesso! Em breve a especialista Graciete Corrêa entrará em contato.');"
          >
            <!-- Campo Nome -->
            <div class="s2-input-field">
              <div class="s2-input-box">
                <svg class="s2-field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <input type="text" id="s2-nome" name="nome" placeholder="Seu nome" class="s2-input" required />
              </div>
            </div>

            <!-- Campo E-mail -->
            <div class="s2-input-field">
              <div class="s2-input-box">
                <svg class="s2-field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input type="email" id="s2-email" name="email" placeholder="E-mail" class="s2-input" required />
              </div>
            </div>

            <!-- Campo Telefone -->
            <div class="s2-input-field">
              <div class="s2-input-box">
                <svg class="s2-field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <input type="tel" id="s2-telefone" name="telefone" placeholder="Telefone/WhatsApp" class="s2-input" required />
              </div>
            </div>

            <!-- Campo Empresa -->
            <div class="s2-input-field">
              <div class="s2-input-box">
                <svg class="s2-field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <input type="text" id="s2-empresa" name="empresa" placeholder="Nome da empresa" class="s2-input" required />
              </div>
            </div>

            <!-- Campo Dropdown Solução -->
            <div class="s2-input-field">
              <div class="s2-input-box">
                <svg class="s2-field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <select id="s2-ajuda" name="ajuda" class="s2-select" required>
                  <option value="" disabled selected>Como podemos ajudar?</option>
                  <option value="cultura">Cultura & Estrutura</option>
                  <option value="lideranca">Liderança & Desenvolvimento</option>
                  <option value="governanca">Governança & Sucessão</option>
                  <option value="outro">Outro desafio de RH Estratégico</option>
                </select>
              </div>
            </div>

            <!-- Botão Enviar Formulário -->
            <button type="submit" class="s2-btn-submit">
              {s2Consultoria.form.buttonText}
            </button>

            <!-- Nota de Segurança -->
            <div class="s2-security-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C88A3B" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>{s2Consultoria.form.securityText}</span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </Container>
</section>
