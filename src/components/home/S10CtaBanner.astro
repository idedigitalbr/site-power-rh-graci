---
// S10CtaBanner.astro — Banner CTA Final de conversão comercial com foto panorâmica e checklist
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-cta-final-banner">
  <div class="container container-wide">
    <div class="cta-banner-wrapper">
      <div class="cta-banner-inner-grid">
        <!-- Coluna 1: Foto do Escritório com Vista ao Pôr do Sol -->
        <div class="cta-banner-photo-col">
          <img
            src={`${base}/assets/imagens-diversas/fotos_graci_ia/07_CTA_FINAL_E_CONTATO/05_sala_com_vista_porto.webp`}
            alt="Mesa de reunião corporativa com vista para o porto"
            loading="lazy"
          />
          <div class="cta-banner-photo-gradient"></div>
        </div>

        <!-- Coluna 2: Título e Descrição Comercial -->
        <div class="cta-banner-content-col">
          <h2 class="cta-banner-heading">
            Vamos conversar sobre<br />
            o futuro da sua empresa?
          </h2>
          <p class="cta-banner-sub">
            Descubra como a PowerRH pode ajudar o seu negócio a crescer com pessoas mais engajadas, líderes mais preparados e resultados sustentáveis.
          </p>
        </div>

        <!-- Coluna 3: Checklist Dourado e Botão CTA -->
        <div class="cta-banner-actions-col">
          <ul class="cta-checklist-final">
            <li class="cta-check-item-final">
              <span class="cta-check-gold-icon">✓</span>
              <span>Diagnóstico inicial sem compromisso</span>
            </li>
            <li class="cta-check-item-final">
              <span class="cta-check-gold-icon">✓</span>
              <span>Conversa direta com a especialista</span>
            </li>
            <li class="cta-check-item-final">
              <span class="cta-check-gold-icon">✓</span>
              <span>Soluções sob medida para a sua realidade</span>
            </li>
          </ul>

          <div>
            <a
              href="#formulario-diagnostico"
              class="btn-gold"
              style="padding: 14px 26px; width: 100%; display: inline-block; text-align: center;"
            >
              QUERO FALAR COM A GRACIETE →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
