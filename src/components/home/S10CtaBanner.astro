---
// S10CtaBanner.astro — Banner CTA Final orientado a dados com foto panorâmica e checklist
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import GoldenArcs from '../ui/GoldenArcs.astro';
import { siteContent } from '../../data/siteContent';

const { ctaBanner } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-cta-final-banner">
  <Container size="wide">
    <div class="cta-banner-wrapper">
      <div class="cta-banner-inner-grid">
        <!-- Coluna 1: Foto da Reunião Estratégica com Executivos -->
        <div class="cta-banner-photo-col">
          <img
            src={`${base}/${ctaBanner.image}`}
            alt="Graciete Corrêa em reunião executiva estratégica com líderes empresariais"
            loading="lazy"
          />
          <div class="cta-banner-photo-gradient"></div>
        </div>

        <!-- Coluna 2: Título e Descrição Comercial -->
        <div class="cta-banner-content-col">
          <h2 class="cta-banner-heading" set:html={ctaBanner.heading} />
          <p class="cta-banner-sub">
            {ctaBanner.desc}
          </p>
        </div>

        <!-- Coluna 3: Checklist Dourado e Botão CTA -->
        <div class="cta-banner-actions-col">
          <ul class="cta-checklist-final">
            {ctaBanner.checklist.map((item) => (
              <li class="cta-check-item-final">
                <span class="cta-check-gold-icon">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div>
            <Button
              href={ctaBanner.ctaHref}
              variant="gold"
              class="w-full text-center flex items-center justify-center py-3.5 px-6.5"
              whatsapp={true}
            >
              {ctaBanner.ctaText}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
