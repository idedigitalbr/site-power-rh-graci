---
// S1Hero.astro — Hero Section panorâmico de alta conversão e estética executiva
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import GoldenArcs from '../ui/GoldenArcs.astro';
import { siteContent } from '../../data/siteContent';

const { hero } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Apenas as fotos oficiais da pasta 01_HOME_HERO_TOPO
const heroImages = [
  'topo-hero (1).webp',
  'topo-hero (2).webp',
  'topo-hero (3).webp',
  'topo-hero (4).webp',
];
---

<section class="hero-final-section" id="inicio">
  <!-- Camada de Imagem Panorâmica em Slideshow Suave (Sem setas, troca direta e leve a cada 20s) -->
  <div class="hero-bg-media-layer" id="heroMediaLayer" aria-hidden="true">
    {heroImages.map((imgName, idx) => (
      <img
        src={`${base}/assets/imagens-diversas/fotos_graci_ia/01_HOME_HERO_TOPO/${encodeURI(imgName)}`}
        alt="Graciete Corrêa — Consultoria Estratégica em Pessoas"
        class={`hero-bg-media-img ${idx === 0 ? 'is-active' : ''}`}
        loading={idx === 0 ? 'eager' : 'lazy'}
        fetchpriority={idx === 0 ? 'high' : 'auto'}
        decoding="async"
        data-slide-index={idx}
      />
    ))}
    <div class="hero-bg-media-gradient"></div>
  </div>

  <!-- Arcos Dourados Finos na margem direita -->
  <GoldenArcs position="right" variant="arcs-right" />

  <Container size="wide" class="hero-container-relative">
    <div class="hero-panoramic-layout">
      <!-- Coluna Esquerda: Copywriting, Headline e Mini-Badges -->
      <div class="hero-copy-box">
        <span class="hero-eyebrow-final">{hero.eyebrow}</span>
        <h1 class="hero-title-final">
          {hero.headlinePrefix}<br />
          quando <span class="highlight-gold">{hero.headlineHighlight}</span><br />
          {hero.headlineSuffix}
        </h1>
        <p class="hero-subtitle-final">
          {hero.subtitle}
        </p>

        <div>
          <Button href={hero.ctaHref} variant="hero-pill" whatsapp={true}>
            {hero.ctaText}
          </Button>
        </div>

        <!-- Mini-Badges de Benefícios Rápidos com Ícones Dourados -->
        <div class="hero-mini-badges-row">
          {hero.miniBadges.map((badge, idx) => (
            <div class="hero-mini-badge-item">
              <div class="mini-badge-icon">
                {idx === 0 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C48D47" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                )}
                {idx === 1 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C48D47" stroke-width="2">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                )}
                {idx === 2 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C48D47" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                )}
                {idx === 3 && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C48D47" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                )}
              </div>
              <div class="mini-badge-text">
                <span>{badge.line1}</span>
                <span>{badge.line2}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>

<script is:inline>
  (() => {
    function initHeroSlideshow() {
      const slides = document.querySelectorAll('#heroMediaLayer .hero-bg-media-img');
      if (slides.length <= 1) return;

      let current = 0;
      const intervalMs = 20000; // Troca automaticamente a cada 20 segundos

      setInterval(() => {
        const prev = current;
        current = (current + 1) % slides.length;

        const prevSlide = slides[prev];
        const nextSlide = slides[current];

        // Mantém a foto anterior como base para transição contínua sem piscar
        prevSlide.classList.add('is-prev');
        prevSlide.classList.remove('is-active');

        // Foto seguinte entra com fade-in suave por cima
        nextSlide.classList.add('is-active');

        // Limpa a foto anterior após a transição de fade (1.3s)
        setTimeout(() => {
          prevSlide.classList.remove('is-prev');
        }, 1300);
      }, intervalMs);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlideshow);
    } else {
      initHeroSlideshow();
    }
  })();
</script>
