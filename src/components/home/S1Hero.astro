---
// S1Hero.astro — Hero Section panorâmico com headline, mini-badges e formulário de diagnóstico
---

<section class="hero-final-section" id="inicio">
  <div class="container container-wide">
    <div class="hero-panoramic-layout">
      <!-- Coluna Esquerda: Copywriting, Headline e Mini-Badges -->
      <div class="hero-copy-box">
        <span class="hero-eyebrow-final">CONSULTORIA ESTRATÉGICA EM PESSOAS</span>
        <h1 class="hero-title-final">
          Empresas crescem<br />
          quando <span class="highlight-gold">pessoas</span><br />
          evoluem.
        </h1>
        <p class="hero-subtitle-final">
          Estratégia, liderança e cultura para transformar<br />
          o potencial humano em resultados reais<br />
          e sustentáveis.
        </p>

        <div>
          <a href="#formulario-diagnostico" class="btn-hero-pill">
            QUERO UM DIAGNÓSTICO →
          </a>
        </div>

        <!-- Mini-Badges de Benefícios Rápidos com Ícones Dourados -->
        <div class="hero-mini-badges-row">
          <div class="hero-mini-badge-item">
            <div class="mini-badge-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#C48D47"
                stroke-width="2"
              >
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <div class="mini-badge-text">
              <span>VISÃO</span>
              <span>ESTRATÉGICA</span>
            </div>
          </div>

          <div class="hero-mini-badge-item">
            <div class="mini-badge-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#C48D47"
                stroke-width="2"
              >
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </div>
            <div class="mini-badge-text">
              <span>FOCO EM</span>
              <span>RESULTADOS</span>
            </div>
          </div>

          <div class="hero-mini-badge-item">
            <div class="mini-badge-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#C48D47"
                stroke-width="2"
              >
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div class="mini-badge-text">
              <span>SOLUÇÕES</span>
              <span>SOB MEDIDA</span>
            </div>
          </div>

          <div class="hero-mini-badge-item">
            <div class="mini-badge-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#C48D47"
                stroke-width="2"
              >
                <path
                  d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                ></path>
              </svg>
            </div>
            <div class="mini-badge-text">
              <span>PARCERIA</span>
              <span>DE LONGO PRAZO</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Coluna Direita: Card de Formulário de Conversão Flutuante -->
      <div class="hero-form-column" id="formulario-diagnostico">
        <div class="hero-form-card-final">
          <div class="hero-form-card-header">
            <h2 class="hero-form-title">Fale com a nossa especialista</h2>
            <p class="hero-form-desc">
              Receba um diagnóstico inicial<br />para a sua empresa.
            </p>
          </div>

          <form
            action="#"
            method="POST"
            onsubmit="event.preventDefault(); alert('Solicitação de diagnóstico enviada com sucesso! Em breve a especialista Graciete Corrêa entrará em contato.');"
          >
            <!-- Campo Nome -->
            <div class="form-field-final">
              <div class="input-with-icon">
                <svg
                  class="input-icon-svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <input
                  type="text"
                  id="hero-nome"
                  class="form-input-final"
                  placeholder="Seu nome"
                  required
                />
              </div>
            </div>

            <!-- Campo E-mail -->
            <div class="form-field-final">
              <div class="input-with-icon">
                <svg
                  class="input-icon-svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input
                  type="email"
                  id="hero-email"
                  class="form-input-final"
                  placeholder="E-mail"
                  required
                />
              </div>
            </div>

            <!-- Campo Telefone -->
            <div class="form-field-final">
              <div class="input-with-icon">
                <svg
                  class="input-icon-svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>
                <input
                  type="tel"
                  id="hero-telefone"
                  class="form-input-final"
                  placeholder="Telefone"
                  required
                />
              </div>
            </div>

            <!-- Campo Empresa -->
            <div class="form-field-final">
              <div class="input-with-icon">
                <svg
                  class="input-icon-svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <input
                  type="text"
                  id="hero-empresa"
                  class="form-input-final"
                  placeholder="Nome da empresa"
                  required
                />
              </div>
            </div>

            <!-- Campo Dropdown Solução -->
            <div class="form-field-final">
              <div class="input-with-icon">
                <svg
                  class="input-icon-svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                  ></path>
                </svg>
                <select id="hero-ajuda" class="form-select-final" required>
                  <option value="">Como podemos ajudar?</option>
                  <option value="cultura">Cultura & Estrutura</option>
                  <option value="lideranca">Liderança & Desenvolvimento</option>
                  <option value="governanca">Governança & Sucessão</option>
                  <option value="outro">Outro desafio de RH Estratégico</option>
                </select>
              </div>
            </div>

            <!-- Botão Enviar Formulário -->
            <button type="submit" class="btn-form-submit">
              SOLICITAR DIAGNÓSTICO →
            </button>

            <!-- Nota de Segurança -->
            <div class="form-security-badge-final">
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Seus dados estão seguros conosco.</span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
