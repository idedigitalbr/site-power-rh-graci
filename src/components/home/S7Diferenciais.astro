---
// S7Diferenciais.astro — Seção Diferenciais orientada a dados com card de destaque
import Container from '../ui/Container.astro';
import GoldenArcs from '../ui/GoldenArcs.astro';
import OrganicTransition from '../ui/OrganicTransition.astro';
import { siteContent } from '../../data/siteContent';

const { diferenciais } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-diferenciais-final" id="diferenciais">
  <!-- Transição Orgânica Sutil (cor exata de S6 #FFFFFF) -->
  <OrganicTransition position="top" fill="#FFFFFF" direction="sweep-b" height={32} />

  <!-- Linhas Douradas Olímpicas nas Bordas e Áreas Negativas (sem tocar textos) -->
  <GoldenArcs position="left" variant="halo-navy" />
  <GoldenArcs position="right" variant="intersect-right" />

  <Container size="wide">
    <div class="diferenciais-grid-final">
      <!-- Lado Esquerdo: 4 Diferenciais Estratégicos -->
      <div>
        <span class="diferenciais-eyebrow">{diferenciais.eyebrow}</span>
        <h2 class="diferenciais-title-final">{diferenciais.title}</h2>

        <div class="diferenciais-cards-grid">
          {diferenciais.items.map((item) => (
            <div class="diferencial-card-single">
              <div class="diferencial-icon-final">
                {item.iconType === 'star' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                  </svg>
                )}
                {item.iconType === 'puzzle' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.5 11H19V7a2 2 0 0 0-2-2h-4V3.5a2.5 2.5 0 0 0-5 0V5H4a2 2 0 0 0-2 2v4h1.5a2.5 2.5 0 0 1 0 5H2v4a2 2 0 0 0 2 2h4v-1.5a2.5 2.5 0 0 1 5 0V22h4a2 2 0 0 0 2-2v-4h1.5a2.5 2.5 0 0 0 0-5z"></path>
                  </svg>
                )}
                {item.iconType === 'chart' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                )}
                {item.iconType === 'award' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="6"></circle>
                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
                  </svg>
                )}
                {item.iconType === 'target' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <circle cx="12" cy="12" r="6"></circle>
                    <circle cx="12" cy="12" r="2"></circle>
                  </svg>
                )}
                {item.iconType === 'shield' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                )}
              </div>
              <h3 class="diferencial-name-final">{item.name || item.title}</h3>
              <p class="diferencial-desc-final">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Lado Direito: Card em Destaque Especial (Foto + Selo Executivo) -->
      <div class="diferenciais-destaque-wrapper">
        <div class="diferenciais-destaque-card">
          <div class="destaque-card-image-box">
            <img
              src={`${base}/${diferenciais.destaque.image}`}
              alt={diferenciais.destaque.title}
              class="destaque-card-img"
              loading="lazy"
            />
          </div>
          <div class="destaque-card-content">
            <div class="destaque-play-row">
              <div class="destaque-play-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span class="destaque-badge-tag">LIDERANÇA COM PROPÓSITO</span>
            </div>
            <h4 class="destaque-card-title">{diferenciais.destaque.title}</h4>
            <p class="destaque-card-desc">{diferenciais.destaque.desc}</p>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <!-- Transição Orgânica Sutil (entrega suavemente em S9 #FCFAF7) -->
  <OrganicTransition position="bottom" fill="#FCFAF7" direction="sweep-a" height={32} />
</section>
