---
// S7Diferenciais.astro — Seção Diferenciais orientada a dados com card de destaque
import Container from '../ui/Container.astro';
import { siteContent } from '../../data/siteContent';

const { diferenciais } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-diferenciais-final" id="diferenciais">
  <Container size="wide">
    <div class="diferenciais-grid-final">
      <!-- Lado Esquerdo: 4 Diferenciais Estratégicos -->
      <div>
        <span class="diferenciais-eyebrow">{diferenciais.eyebrow}</span>
        <h2 class="diferenciais-title-final">{diferenciais.title}</h2>

        <div class="diferenciais-cards-grid">
          {diferenciais.items.map((item) => (
            <div class="diferencial-card-single">
              <div class="diferencial-icon-final">
                {item.iconType === 'star' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                  </svg>
                )}
                {item.iconType === 'puzzle' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                )}
                {item.iconType === 'chart' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                )}
                {item.iconType === 'award' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                )}
              </div>
              <h3 class="diferencial-name-final">{item.name}</h3>
              <p class="diferencial-desc-final">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Lado Direito: Card de Destaque Emocional com Foto e Painel Quente -->
      <div>
        <div class="diferenciais-destaque-card">
          <div class="destaque-card-image-box">
            <img
              src={`${base}/${diferenciais.destaque.image}`}
              alt={diferenciais.destaque.title}
              class="destaque-card-img"
              loading="lazy"
            />
          </div>
          <div class="destaque-card-content">
            <div class="destaque-play-row">
              <div class="destaque-play-btn" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span class="destaque-badge-tag">LIDERANÇA COM PROPÓSITO</span>
            </div>
            <h4 class="destaque-card-title">{diferenciais.destaque.title}</h4>
            <p class="destaque-card-desc">{diferenciais.destaque.desc}</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
