---
// S5Processo.astro — Seção Como Trabalhamos (Método estruturado em 4 etapas)
import Container from '../ui/Container.astro';
import GoldenArcs from '../ui/GoldenArcs.astro';
import OrganicTransition from '../ui/OrganicTransition.astro';
import { siteContent } from '../../data/siteContent';

const { processo } = siteContent;
---

<section class="section-processo-final">
  <!-- Transição Orgânica Sutil (cor exata de S4 #FAF7F2, 0 filete branco) -->
  <OrganicTransition position="top" fill="#FAF7F2" direction="sweep-a" height={32} />

  <!-- Arcos Dourados Finos Orgânicos nas Bordas -->
  <GoldenArcs position="left" variant="intersect-left" />
  <GoldenArcs position="right" variant="arcs-right" />

  <Container size="wide">
    <div class="processo-header-layout-final">
      <div>
        <span class="hero-eyebrow-final" style="margin-bottom: 4px;">{processo.eyebrow}</span>
        <h2 class="processo-title-final">{processo.title}</h2>
      </div>

      <div class="processo-steps-track">
        {processo.steps.map((step, idx) => (
          <div class="step-card-final">
            <div class="step-circle-badge-final">{step.step}</div>
            {idx < processo.steps.length - 1 && <div class="step-arrow-tail"></div>}
            <h3 class="step-title-final">{step.title}</h3>
            <p class="step-desc-final">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </Container>

  <!-- Transição Orgânica Sutil (entrega suavemente em S6 #FFFFFF) -->
  <OrganicTransition position="bottom" fill="#FFFFFF" direction="sweep-b" height={32} />
</section>
