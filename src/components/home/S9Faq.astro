---
// S9Faq.astro — Seção FAQ orientada a dados com acordeão interativo
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import GoldenArcs from '../ui/GoldenArcs.astro';
import { siteContent } from '../../data/siteContent';

const { faq } = siteContent;
---

<section class="section-faq-final" id="faq">
  <!-- Arcos Dourados Finos Orgânicos na margem esquerda -->
  <GoldenArcs position="left" variant="intersect-left" />

  <Container size="wide">
    <div class="faq-layout-final">
      <div>
        <span class="hero-eyebrow-final" style="margin-bottom: 4px;">{faq.eyebrow}</span>
        <h2 class="faq-title-final">{faq.title}</h2>
        <p class="faq-desc-final">{faq.desc}</p>
        <Button
          href={faq.ctaHref}
          variant="gold"
          class="text-xs py-2 px-5"
          whatsapp={true}
        >
          {faq.ctaText}
        </Button>
      </div>

      <div class="faq-accordion-list">
        {faq.items.map((item) => (
          <div class={`faq-item-final ${item.isOpenDefault ? 'active' : ''}`.trim()}>
            <button
              type="button"
              class="faq-btn-trigger"
              aria-expanded={item.isOpenDefault ? 'true' : 'false'}
            >
              <span>{item.question}</span>
              <span class="faq-chevron-icon">▼</span>
            </button>
            <div class="faq-answer-body">
              {item.answer}
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
