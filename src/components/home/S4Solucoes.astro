---
// S4Solucoes.astro — Seção Nossas Soluções com layout Bento editorial assimétrico refinado
import Container from '../ui/Container.astro';
import { siteContent } from '../../data/siteContent';

const { solucoes } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const cultura = solucoes.items.find((item) => item.id === 'cultura') || solucoes.items[0];
const lideranca = solucoes.items.find((item) => item.id === 'lideranca') || solucoes.items[1];
const governanca = solucoes.items.find((item) => item.id === 'governanca') || solucoes.items[2];
---

<section class="section-solucoes-modern" id="solucoes">
  <!-- Linhas decorativas douradas de fundo (curvas refinadas nas laterais) -->
  <div class="solucoes-bg-decor" aria-hidden="true">
    <svg class="decor-line-left" viewBox="0 0 360 600" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-80 120 C100 160 180 340 30 520" stroke="#C88A3B" stroke-width="1.3" stroke-opacity="0.32" />
      <path d="M-50 200 C120 240 200 400 70 570" stroke="#C88A3B" stroke-width="1.3" stroke-opacity="0.18" />
    </svg>
    <svg class="decor-line-right" viewBox="0 0 360 600" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M420 140 C240 200 180 380 310 560" stroke="#C88A3B" stroke-width="1.3" stroke-opacity="0.30" />
      <path d="M400 220 C260 270 210 420 330 600" stroke="#C88A3B" stroke-width="1.3" stroke-opacity="0.18" />
    </svg>
  </div>

  <Container size="wide">
    <!-- Cabeçalho Centralizado com Linhas Douradas -->
    <div class="solucoes-header">
      <div class="solucoes-eyebrow-wrap">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span class="eyebrow-text">{solucoes.eyebrow}</span>
        <span class="eyebrow-line" aria-hidden="true"></span>
      </div>
      <h2 class="solucoes-main-title">
        Soluções estratégicas para<br />
        fortalecer cultura, liderança e legado.
      </h2>
    </div>

    <!-- Layout Bento Editorial Monolítico -->
    <div class="solucoes-bento-grid">
      
      <!-- LINHA 1: Foto Reunião Estratégica (Esquerda) + Card Cultura Organizacional (Direita) -->
      <div class="solucoes-row-top">
        <!-- Foto Ampla da Reunião Executiva -->
        <div class="solucao-media-card photo-wide">
          <img
            src={`${base}/${cultura.image}`}
            alt={cultura.alt}
            class="bento-photo-img"
            loading="lazy"
          />
        </div>

        <!-- Card Navy: Cultura Organizacional -->
        <article class="solucao-card-navy">
          <div class="card-navy-header">
            <!-- Ícone Gold: 2 Pessoas / Comunidade -->
            <div class="card-icon-gold">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3 class="card-navy-title">
              Cultura<br />Organizacional
            </h3>
            <p class="card-navy-desc">
              {cultura.desc}
            </p>
          </div>
          <a
            href="#formulario-diagnostico"
            class="solucao-arrow-btn btn-right"
            aria-label={`Conhecer ${cultura.title}`}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </article>
      </div>

      <!-- LINHA 2: (Card Líderes + Foto Retrato) + Card Governança & Sucessão -->
      <div class="solucoes-row-bottom">
        
        <!-- Subgrid Esquerda: Card Light + Foto Retrato -->
        <div class="solucoes-subgrid-left">
          
          <!-- Card Light: Líderes de Líderes com Curva Orgânica Quente no Canto -->
          <article class="solucao-card-light">
            <!-- Curva Orgânica Fluida em Tom Areia/Creme Quente -->
            <div class="organic-wave-corner" aria-hidden="true">
              <svg viewBox="0 0 180 150" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M180 15C150 55 120 90 75 115C35 135 15 142 0 150H180V15Z" fill="#F0E5D4" />
              </svg>
            </div>

            <div class="card-light-header">
              <!-- Ícone Gold: Gráfico de Barras / Performance (Alinhado à Esquerda) -->
              <div class="card-icon-gold">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
              </div>
              <h3 class="card-light-title">
                Líderes de<br />Líderes
              </h3>
              <p class="card-light-desc">
                {lideranca.desc}
              </p>
            </div>

            <!-- Botão de Seta Alinhado à Esquerda -->
            <a
              href="#formulario-diagnostico"
              class="solucao-arrow-btn btn-left"
              aria-label={`Conhecer ${lideranca.title}`}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </article>

          <!-- Foto Retrato do Líder / Facilitador -->
          <div class="solucao-media-card photo-portrait">
            <img
              src={`${base}/${lideranca.image}`}
              alt={lideranca.alt}
              class="bento-photo-img"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Card Governança & Sucessão: Foto no Topo + Barra Navy Compacta -->
        <article class="solucao-card-governanca">
          <div class="governanca-img-wrap">
            <img
              src={`${base}/${governanca.image}`}
              alt={governanca.alt}
              class="bento-photo-img"
              loading="lazy"
            />
          </div>
          <div class="governanca-bottom-bar">
            <div class="governanca-content-block">
              <!-- Ícone Gold: Relógio / Continuidade e Governança -->
              <div class="card-icon-gold flex-shrink-0">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 14 14"></polyline>
                </svg>
              </div>
              <div class="governanca-text-wrap">
                <h3 class="governanca-card-title">{governanca.title}</h3>
                <p class="governanca-card-desc">{governanca.desc}</p>
              </div>
            </div>
            <a
              href="#formulario-diagnostico"
              class="solucao-arrow-btn btn-right flex-shrink-0"
              aria-label={`Conhecer ${governanca.title}`}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

      </div>
    </div>
  </Container>
</section>

<style>
  .section-solucoes-modern {
    position: relative;
    background-color: #FAF7F2;
    padding: 85px 0 95px;
    overflow: hidden;
  }

  /* Linhas decorativas douradas de fundo */
  .solucoes-bg-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .decor-line-left {
    position: absolute;
    top: 15%;
    left: 0;
    width: 340px;
    height: 600px;
    -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0.95) 45%, rgba(0,0,0,0) 95%);
    mask-image: linear-gradient(to right, rgba(0,0,0,0.95) 45%, rgba(0,0,0,0) 95%);
  }

  .decor-line-right {
    position: absolute;
    top: 18%;
    right: 0;
    width: 340px;
    height: 600px;
    -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,0.95) 45%, rgba(0,0,0,0) 95%);
    mask-image: linear-gradient(to left, rgba(0,0,0,0.95) 45%, rgba(0,0,0,0) 95%);
  }

  /* Cabeçalho da Seção */
  .solucoes-header {
    position: relative;
    z-index: 1;
    text-align: center;
    margin-bottom: 44px;
  }

  .solucoes-eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .eyebrow-line {
    display: inline-block;
    width: 36px;
    height: 1px;
    background-color: #C88A3B;
    opacity: 0.7;
  }

  .eyebrow-text {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #C88A3B;
    text-transform: uppercase;
  }

  .solucoes-main-title {
    font-family: var(--font-sans);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 800;
    color: #0A1F33;
    line-height: 1.2;
    margin: 0 auto;
    max-width: 740px;
    letter-spacing: -0.02em;
  }

  /* Grid Bento Monolítico com Gaps Precisos */
  .solucoes-bento-grid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
  }

  /* Linhas do Bento Grid com proporção harmônica idêntica de cima a baixo */
  .solucoes-row-top {
    display: grid;
    grid-template-columns: 1.48fr 1fr;
    gap: 18px;
    height: 290px;
  }

  .solucoes-row-bottom {
    display: grid;
    grid-template-columns: 1.48fr 1fr;
    gap: 18px;
    height: 290px;
  }

  .solucoes-subgrid-left {
    display: grid;
    grid-template-columns: 1.32fr 1fr;
    gap: 18px;
    height: 100%;
  }

  /* Caixas de Fotos */
  .solucao-media-card {
    border-radius: 22px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 10px 30px -8px rgba(11, 27, 44, 0.08);
    background-color: #EDE7DD;
    height: 100%;
  }

  .bento-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solucao-media-card:hover .bento-photo-img {
    transform: scale(1.035);
  }

  /* Ícones Dourados */
  .card-icon-gold {
    color: #C88A3B;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: fit-content;
  }

  /* Botão de Seta Circular */
  .solucao-arrow-btn {
    width: 42px;
    height: 42px;
    border-radius: 9999px;
    border: 1.5px solid #C88A3B;
    color: #C88A3B;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solucao-arrow-btn:hover {
    background-color: #C88A3B;
    color: #FFFFFF;
    transform: translateX(3px);
  }

  .btn-right {
    margin-left: auto;
    align-self: flex-end;
  }

  .btn-left {
    margin-right: auto;
    align-self: flex-start;
    margin-top: auto;
  }

  /* Card Navy: Cultura Organizacional */
  .solucao-card-navy {
    background-color: #072238;
    background-image: linear-gradient(145deg, #09263E 0%, #051A2C 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    padding: 32px 34px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 14px 34px -8px rgba(5, 26, 44, 0.18);
    cursor: pointer;
    height: 100%;
    transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solucao-card-navy:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 42px -8px rgba(5, 26, 44, 0.35), 0 0 16px -2px rgba(200, 138, 59, 0.2);
    border-color: rgba(200, 138, 59, 0.65);
  }

  .solucao-card-navy:hover .solucao-arrow-btn {
    background-color: #C88A3B;
    color: #FFFFFF;
    border-color: #C88A3B;
    transform: translateX(4px);
  }

  .card-navy-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
  }

  .card-navy-title {
    font-family: var(--font-sans);
    font-size: 28px;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .card-navy-desc {
    font-size: 14px;
    color: #9BB0C1;
    line-height: 1.5;
    margin: 0;
    max-width: 320px;
  }

  /* Card Ouro: Líderes de Líderes */
  .solucao-card-light {
    position: relative;
    background: linear-gradient(135deg, #C88A3B 0%, #B07427 100%);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 22px;
    padding: 28px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 12px 30px -6px rgba(184, 123, 46, 0.35);
    cursor: pointer;
    height: 100%;
    transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solucao-card-light:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 42px -6px rgba(184, 123, 46, 0.5), 0 0 16px rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .solucao-card-light .card-icon-gold {
    color: #FFFFFF;
  }

  .organic-wave-corner {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 160px;
    height: 135px;
    pointer-events: none;
    z-index: 0;
  }

  .organic-wave-corner svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .solucao-card-light .organic-wave-corner path {
    fill: rgba(255, 255, 255, 0.14);
  }

  .card-light-header {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
  }

  .card-light-title {
    font-family: var(--font-sans);
    font-size: 28px;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .card-light-desc {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.5;
    margin: 0;
    max-width: 270px;
  }

  .solucao-card-light .solucao-arrow-btn {
    position: relative;
    z-index: 1;
    background-color: #072238;
    color: #FFFFFF;
    border-color: #072238;
    box-shadow: 0 4px 12px rgba(7, 34, 56, 0.3);
  }

  .solucao-card-light:hover .solucao-arrow-btn {
    background-color: #FFFFFF;
    color: #B07427;
    border-color: #FFFFFF;
    transform: translateX(4px);
  }

  /* Card Governança & Sucessão: Foto no Topo + Barra Navy Compacta */
  .solucao-card-governanca {
    background-color: #072238;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 14px 34px -8px rgba(5, 26, 44, 0.16);
    cursor: pointer;
    height: 100%;
    transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solucao-card-governanca:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 42px -8px rgba(5, 26, 44, 0.35), 0 0 16px -2px rgba(200, 138, 59, 0.2);
    border-color: rgba(200, 138, 59, 0.65);
  }

  .solucao-card-governanca:hover .solucao-arrow-btn {
    background-color: #C88A3B;
    color: #FFFFFF;
    border-color: #C88A3B;
    transform: translateX(4px);
  }

  .governanca-img-wrap {
    flex: 1;
    overflow: hidden;
    position: relative;
    background-color: #EDE7DD;
    min-height: 190px;
  }

  .governanca-img-wrap .bento-photo-img {
    object-position: center 30%;
  }

  .solucao-card-governanca:hover .governanca-img-wrap .bento-photo-img {
    transform: scale(1.035);
  }

  .governanca-bottom-bar {
    background-color: #072238;
    background-image: linear-gradient(145deg, #09263E 0%, #051A2C 100%);
    padding: 16px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-shrink: 0;
  }

  .governanca-content-block {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .governanca-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .governanca-card-title {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.2;
    margin: 0;
  }

  .governanca-card-desc {
    font-size: 12.5px;
    color: #9BB0C1;
    line-height: 1.4;
    margin: 0;
  }

  /* Responsividade Fluida */
  @media (max-width: 1024px) {
    .solucoes-row-top,
    .solucoes-row-bottom {
      grid-template-columns: 1fr;
      height: auto;
      gap: 18px;
    }

    .solucao-media-card.photo-wide {
      height: 260px;
    }

    .solucao-card-navy {
      height: 260px;
    }

    .solucoes-subgrid-left {
      grid-template-columns: 1fr 1fr;
      height: 280px;
    }

    .solucao-card-governanca {
      height: 280px;
    }
  }

  @media (max-width: 680px) {
    .section-solucoes-modern {
      padding: 60px 0 70px;
    }

    .solucoes-header {
      margin-bottom: 32px;
    }

    .solucoes-bento-grid {
      gap: 16px;
    }

    .solucoes-subgrid-left {
      grid-template-columns: 1fr;
      height: auto;
    }

    .solucao-media-card.photo-portrait {
      height: 240px;
    }

    .solucao-card-light {
      height: 260px;
    }

    .solucao-card-navy {
      padding: 26px 24px;
      height: auto;
      min-height: 240px;
    }

    .solucao-card-light {
      padding: 26px 24px;
    }

    .solucao-card-governanca {
      height: 300px;
    }

    .governanca-bottom-bar {
      padding: 14px 18px;
    }
  }
</style>
