---
// S4Solucoes.astro — Seção Nossas Soluções com 3 cards fotográficos orientada a dados
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { siteContent } from '../../data/siteContent';

const { solucoes } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section-solucoes-final" id="solucoes">
  <Container size="wide">
    <SectionHeader
      eyebrow={solucoes.eyebrow}
      title={solucoes.title}
      center={true}
    />

    <div class="solucoes-grid-final">
      {solucoes.items.map((card) => (
        <article class="solucao-card-final">
          <div class="solucao-img-box-final">
            <img
              src={`${base}/${card.image}`}
              alt={card.alt}
              class="solucao-img-final"
              loading="lazy"
            />
          </div>
          <div class="solucao-footer-bar-final">
            <div class="solucao-text-block-final">
              <div class="solucao-title-row">
                {card.iconType === 'culture' && (
                  <svg class="solucao-icon-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                )}
                {card.iconType === 'leadership' && (
                  <svg class="solucao-icon-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                )}
                {card.iconType === 'governance' && (
                  <svg class="solucao-icon-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 14 14"></polyline>
                  </svg>
                )}
                <h3 class="solucao-title-final">{card.title}</h3>
              </div>
              <p class="solucao-desc-final">{card.desc}</p>
            </div>
            <a
              href="#formulario-diagnostico"
              class="solucao-arrow-btn-final"
              aria-label={`Conhecer ${card.title}`}
            >
              →
            </a>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>
