---
// S4Solucoes.astro — Seção Nossas Soluções com layout Bento editorial assimétrico refinado
import Container from '../ui/Container.astro';
import { siteContent } from '../../data/siteContent';

const { solucoes } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const cultura = solucoes.items[0];
const lideranca = solucoes.items[1];
const governanca = solucoes.items[2];
---

<section class="section-solucoes-modern" id="solucoes">
  <!-- Linhas decorativas douradas de fundo (curvas refinadas nas laterais) -->
  <div class="solucoes-bg-decor" aria-hidden="true">
    <svg class="decor-line-left" viewBox="0 0 360 600" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-80 120 C100 160 180 340 30 520" stroke="#C88A3B" stroke-width="1.3" stroke-opacity="0.32" />
      <path d="M-50 200 C120 240 200 400 70 570" stroke="#C88A3B" stroke-width="1.3" stroke-opacity="0.18" />
    </svg>
    <svg class="decor-line-right" viewBox="0 0 360 600" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M420 140 C240 200 180 380 310 560" stroke="#C88A3B" stroke-width="1.3" stroke-opacity="0.30" />
      <path d="M400 220 C260 270 210 420 330 600" stroke="#C88A3B" stroke-width="1.3" stroke-opacity="0.18" />
    </svg>
  </div>

  <Container size="wide">
    <!-- Cabeçalho Centralizado com Linhas Douradas -->
    <div class="solucoes-header">
      <div class="solucoes-eyebrow-wrap">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span class="eyebrow-text">{solucoes.eyebrow}</span>
        <span class="eyebrow-line" aria-hidden="true"></span>
      </div>
      <h2 class="solucoes-main-title">
        Três pilares integrados para<br />
        fortalecer a gestão e os resultados.
      </h2>
    </div>

    <!-- Layout Bento Editorial Monolítico -->
    <div class="solucoes-bento-grid">
      
      <!-- LINHA 1: Foto Reunião Estratégica (Esquerda) + Card Advisor de Negócios (Direita) -->
      <div class="solucoes-row-top">
        <!-- Foto Ampla da Reunião Executiva -->
        <div class="solucao-media-card photo-wide">
          <img
            src={`${base}/${cultura.image}`}
            alt={cultura.alt}
            class="bento-photo-img"
            loading="lazy"
          />
        </div>

        <!-- Card Navy: Advisory de Negócios e Cultura -->
        <a
          href={`${base}/servicos/${cultura.slug}`}
          class="solucao-card-navy"
          aria-label={`Conhecer página de ${cultura.title}`}
        >
          <div class="card-navy-header">
            <!-- Ícone Gold: 2 Pessoas / Comunidade -->
            <div class="card-icon-gold">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3 class="card-navy-title">
              {cultura.title}
            </h3>
          </div>

          <!-- Subitens com Ícones Circulares (Estilo Anexo 3) -->
          <div class="solucao-subitens-list">
            <div class="subitem-row">
              <div class="subitem-icon-circle">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle>
                  <polyline points="12 6 12 12 14 14"></polyline>
                </svg>
              </div>
              <span class="subitem-title">Planejamento estratégico</span>
            </div>

            <div class="subitem-row">
              <div class="subitem-icon-circle">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span class="subitem-title">Governança e sucessão familiar</span>
            </div>

            <div class="subitem-row">
              <div class="subitem-icon-circle">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
              <span class="subitem-title">Cultura organizacional</span>
            </div>
          </div>

          <div class="card-footer-action">
            <span class="solucao-arrow-btn btn-right" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>
      </div>

      <!-- LINHA 2: (Card Líderes + Foto Retrato) + Card Processos e Estrutura Organizacional -->
      <div class="solucoes-row-bottom">
        
        <!-- Subgrid Esquerda: Card Light + Foto Retrato -->
        <div class="solucoes-subgrid-left">
          
          <!-- Card Light: Pessoas, Liderança e Performance com Curva Orgânica Quente no Canto -->
          <a
            href={`${base}/servicos/${lideranca.slug}`}
            class="solucao-card-light"
            aria-label={`Conhecer página de ${lideranca.title}`}
          >
            <!-- Curva Orgânica Fluida em Tom Areia/Creme Quente -->
            <div class="organic-wave-corner" aria-hidden="true">
              <svg viewBox="0 0 180 150" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M180 15C150 55 120 90 75 115C35 135 15 142 0 150H180V15Z" fill="#F0E5D4" />
              </svg>
            </div>

            <div class="card-light-header">
              <!-- Ícone Gold: Gráfico de Barras / Performance -->
              <div class="card-icon-gold">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
              </div>
              <h3 class="card-light-title">
                {lideranca.title}
              </h3>
            </div>

            <!-- Subitens com Ícones Circulares (Estilo Anexo 3) -->
            <div class="solucao-subitens-list">
              <div class="subitem-row">
                <div class="subitem-icon-circle">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                </div>
                <span class="subitem-title">Engenharia de equipes</span>
              </div>

              <div class="subitem-row">
                <div class="subitem-icon-circle">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                </div>
                <span class="subitem-title">Desenvolvimento de lideranças</span>
              </div>

              <div class="subitem-row">
                <div class="subitem-icon-circle">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                  </svg>
                </div>
                <span class="subitem-title">Performance</span>
              </div>
            </div>

            <!-- Botão de Seta Alinhado à Direita -->
            <div class="card-footer-action">
              <span class="solucao-arrow-btn btn-right" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </a>

          <!-- Foto Retrato do Líder / Facilitador -->
          <div class="solucao-media-card photo-portrait">
            <img
              src={`${base}/${lideranca.image}`}
              alt={lideranca.alt}
              class="bento-photo-img"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Card Processos e Estrutura Organizacional -->
        <a
          href={`${base}/servicos/${governanca.slug}`}
          class="solucao-card-navy solucao-card-processos"
          style={`--card-bg-img: url('${base}/${governanca.image}');`}
          aria-label={`Conhecer página de ${governanca.title}`}
        >
          <div class="card-navy-header">
            <!-- Ícone Gold: Relógio / Estrutura e Governança -->
            <div class="card-icon-gold">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                <rect x="8.5" y="14" width="7" height="7" rx="1"></rect>
                <path d="M6.5 10v3h11v-3M12 13v1"></path>
              </svg>
            </div>
            <h3 class="card-navy-title">
              {governanca.title}
            </h3>
          </div>

          <!-- Subitens com Ícones Circulares (Estilo Anexo 3) -->
          <div class="solucao-subitens-list">
            <div class="subitem-row">
              <div class="subitem-icon-circle">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                  <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                  <rect x="8.5" y="14" width="7" height="7" rx="1"></rect>
                  <path d="M6.5 10v3h11v-3M12 13v1"></path>
                </svg>
              </div>
              <span class="subitem-title">Design organizacional</span>
            </div>

            <div class="subitem-row">
              <div class="subitem-icon-circle">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
              </div>
              <span class="subitem-title">Mapeamento e processos</span>
            </div>

            <div class="subitem-row">
              <div class="subitem-icon-circle">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="7"></circle>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                </svg>
              </div>
              <span class="subitem-title">Cargos, Carreiras e Salários</span>
            </div>
          </div>

          <div class="card-footer-action">
            <span class="solucao-arrow-btn btn-right" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>

      </div>
    </div>

    <!-- Botão Central: Explorar Todas as 3 Soluções & Advisory -->
    <div class="solucoes-hub-cta-wrap">
      <a href={`${base}/servicos`} class="btn-solucoes-hub-pill">
        <span>Conhecer as três soluções da PowerRH</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </Container>
</section>

<style>
  .section-solucoes-modern {
    position: relative;
    background-color: #FAF7F2;
    padding: 85px 0 95px;
    overflow: hidden;
  }

  /* Linhas decorativas douradas de fundo */
  .solucoes-bg-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .decor-line-left {
    position: absolute;
    top: 15%;
    left: 0;
    width: 340px;
    height: 600px;
    -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0.95) 45%, rgba(0,0,0,0) 95%);
    mask-image: linear-gradient(to right, rgba(0,0,0,0.95) 45%, rgba(0,0,0,0) 95%);
  }

  .decor-line-right {
    position: absolute;
    top: 18%;
    right: 0;
    width: 340px;
    height: 600px;
    -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,0.95) 45%, rgba(0,0,0,0) 95%);
    mask-image: linear-gradient(to left, rgba(0,0,0,0.95) 45%, rgba(0,0,0,0) 95%);
  }

  /* Cabeçalho da Seção */
  .solucoes-header {
    position: relative;
    z-index: 1;
    text-align: center;
    margin-bottom: 44px;
  }

  .solucoes-eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .eyebrow-line {
    display: inline-block;
    width: 36px;
    height: 1px;
    background-color: #C88A3B;
    opacity: 0.7;
  }

  .eyebrow-text {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #C88A3B;
    text-transform: uppercase;
  }

  .solucoes-main-title {
    font-family: var(--font-sans);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 800;
    color: #0A1F33;
    line-height: 1.2;
    margin: 0 auto;
    max-width: 740px;
    letter-spacing: -0.02em;
  }

  /* Grid Bento Monolítico com Gaps Precisos */
  .solucoes-bento-grid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
  }

  /* Linhas do Bento Grid com proporção harmônica idêntica de cima a baixo */
  .solucoes-row-top {
    display: grid;
    grid-template-columns: 1.48fr 1fr;
    gap: 18px;
    height: 345px;
  }

  .solucoes-row-bottom {
    display: grid;
    grid-template-columns: 1.48fr 1fr;
    gap: 18px;
    height: 345px;
  }

  .solucoes-subgrid-left {
    display: grid;
    grid-template-columns: 1.32fr 1fr;
    gap: 18px;
    height: 100%;
  }

  /* Caixas de Fotos */
  .solucao-media-card {
    border-radius: 22px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 10px 30px -8px rgba(11, 27, 44, 0.08);
    background-color: #EDE7DD;
    height: 100%;
  }

  .bento-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solucao-media-card:hover .bento-photo-img {
    transform: scale(1.035);
  }

  /* Ícones Dourados */
  .card-icon-gold {
    color: #C88A3B;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: fit-content;
  }

  /* Botão de Seta Circular */
  .solucao-arrow-btn {
    width: 42px;
    height: 42px;
    border-radius: 9999px;
    border: 1.5px solid #C88A3B;
    color: #C88A3B;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solucao-arrow-btn:hover {
    background-color: #C88A3B;
    color: #FFFFFF;
    transform: translateX(3px);
  }

  .btn-right {
    margin-left: auto;
    align-self: flex-end;
  }

  .btn-left {
    margin-right: auto;
    align-self: flex-start;
    margin-top: auto;
  }

  /* Card Navy: Advisory de Negócios e Cultura */
  .solucao-card-navy {
    background-color: #072238;
    background-image: linear-gradient(145deg, #09263E 0%, #051A2C 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    padding: 30px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 14px 34px -8px rgba(5, 26, 44, 0.18);
    cursor: pointer;
    height: 100%;
    text-decoration: none;
    color: inherit;
    transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solucao-card-navy:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 42px -8px rgba(5, 26, 44, 0.35), 0 0 16px -2px rgba(200, 138, 59, 0.2);
    border-color: rgba(200, 138, 59, 0.65);
  }

  .solucao-card-navy:hover .solucao-arrow-btn {
    background-color: #C88A3B;
    color: #FFFFFF;
    border-color: #C88A3B;
    transform: translateX(4px);
  }

  .card-navy-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    text-align: left;
  }

  .card-navy-title {
    font-family: var(--font-sans);
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.18;
    margin: 0;
    letter-spacing: -0.015em;
  }

  /* Card Ouro: Pessoas, Liderança e Performance */
  .solucao-card-light {
    position: relative;
    background: linear-gradient(135deg, #C88A3B 0%, #B07427 100%);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 22px;
    padding: 28px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 12px 30px -6px rgba(184, 123, 46, 0.35);
    cursor: pointer;
    height: 100%;
    text-decoration: none;
    color: inherit;
    transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .solucao-card-light:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 42px -6px rgba(184, 123, 46, 0.5), 0 0 16px rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .solucao-card-light .card-icon-gold {
    color: #FFFFFF;
  }

  .organic-wave-corner {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 160px;
    height: 135px;
    pointer-events: none;
    z-index: 0;
  }

  .organic-wave-corner svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .solucao-card-light .organic-wave-corner path {
    fill: rgba(255, 255, 255, 0.14);
  }

  .card-light-header {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    text-align: left;
  }

  .card-light-title {
    font-family: var(--font-sans);
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.18;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .solucao-card-light .solucao-arrow-btn {
    position: relative;
    z-index: 1;
    background-color: #072238;
    color: #FFFFFF;
    border-color: #072238;
    box-shadow: 0 4px 12px rgba(7, 34, 56, 0.3);
  }

  .solucao-card-light:hover .solucao-arrow-btn {
    background-color: #FFFFFF;
    color: #B07427;
    border-color: #FFFFFF;
    transform: translateX(4px);
  }

  /* Card Processos e Estrutura Organizacional: Estilo Navy com Textura Sutil */
  .solucao-card-processos {
    position: relative;
    background-color: #072238;
    background-image: linear-gradient(145deg, rgba(9, 38, 62, 0.94) 0%, rgba(5, 26, 44, 0.97) 100%), var(--card-bg-img);
    background-size: cover;
    background-position: center 30%;
  }

  .solucao-card-processos:hover {
    background-image: linear-gradient(145deg, rgba(9, 38, 62, 0.88) 0%, rgba(5, 26, 44, 0.93) 100%), var(--card-bg-img);
  }

  /* Subitens com Ícones Circulares (Idêntico ao Padrão de Imagem 3 / S6Sobre) */
  .solucao-subitens-list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin-top: 16px;
    margin-bottom: 12px;
    width: 100%;
  }

  .subitem-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Círculo com Ícone (Estilo Anexo 3) */
