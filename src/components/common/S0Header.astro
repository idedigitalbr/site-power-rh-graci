---
// S0Header.astro — Header institucional com emblema vetorial dourado, navegação e CTA
---

<header class="site-header-final">
  <div class="container container-wide">
    <nav class="site-nav-final" aria-label="Navegação Principal">
      <!-- Logo Institucional PowerRH com Emblema Vetorial Dourado -->
      <a href="#inicio" class="brand-link-final">
        <svg class="brand-emblem-svg" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="44" height="44" rx="10" fill="#01243E"></rect>
          <path d="M12 11H24C28.4183 11 32 14.5817 32 19C32 23.4183 28.4183 27 24 27H18V33H12V11Z" fill="url(#goldGradientLogo)"></path>
          <circle cx="28.5" cy="30.5" r="4.5" fill="#C88A3B"></circle>
          <defs>
            <linearGradient id="goldGradientLogo" x1="12" y1="11" x2="32" y2="33" gradientUnits="userSpaceOnUse">
              <stop stop-color="#D49B55"></stop>
              <stop offset="1" stop-color="#B87B2E"></stop>
            </linearGradient>
          </defs>
        </svg>
        <div class="brand-text-final">
          <span class="brand-title-final">PowerRH</span>
          <span class="brand-tagline-final">Pessoas que transformam negócios</span>
        </div>
      </a>

      <!-- Menu de Links -->
      <ul class="nav-links-final">
        <li><a href="#inicio" class="nav-link-final active">Home</a></li>
        <li><a href="#sobre" class="nav-link-final">Sobre</a></li>
        <li><a href="#solucoes" class="nav-link-final">Soluções</a></li>
        <li><a href="#depoimentos" class="nav-link-final">Depoimentos</a></li>
        <li><a href="#formulario-diagnostico" class="nav-link-final">Contato</a></li>
      </ul>

      <!-- CTA Principal Header -->
      <div>
        <a href="#formulario-diagnostico" class="btn-gold">
          Falar com a especialista →
        </a>
      </div>
    </nav>
  </div>
</header>
