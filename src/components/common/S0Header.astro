---
// S0Header.astro — Header institucional padronizado e orientado a dados
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { siteContent } from '../../data/siteContent';

const { navigation } = siteContent;
---

<header class="site-header-final">
  <Container size="wide">
    <nav class="site-nav-final" aria-label="Navegação Principal">
      <!-- Logo Institucional PowerRH com Emblema Orgânico Dourado -->
      <a href="#inicio" class="brand-link-final">
        <svg class="brand-emblem-svg" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="goldLogoGrad" x1="4" y1="4" x2="32" y2="32" gradientUnits="userSpaceOnUse">
              <stop stop-color="#E5AF63" />
              <stop offset="1" stop-color="#B87B2E" />
            </linearGradient>
          </defs>
          <!-- Pétala 1 (Superior direita curva) -->
          <path d="M17 19C17 9 24 3 32 4C33 13 26 21 17 19Z" fill="url(#goldLogoGrad)" />
          <!-- Pétala 2 (Inferior esquerda ascendente) -->
          <path d="M7 29C6 20 12 13 21 13C20 22 13 30 7 29Z" fill="url(#goldLogoGrad)" opacity="0.9" />
        </svg>
        <div class="brand-text-final">
          <span class="brand-title-final">{navigation.brandName}</span>
          <span class="brand-tagline-final">{navigation.brandTagline}</span>
        </div>
      </a>

      <!-- Menu de Links Dinâmicos -->
      <ul class="nav-links-final">
        {navigation.links.map((link) => (
          <li>
            <a href={link.href} class={`nav-link-final ${link.active ? 'active' : ''}`.trim()}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA Principal Header -->
      <div>
        <Button href={navigation.cta.href} variant="gold">
          {navigation.cta.text}
        </Button>
      </div>
    </nav>
  </Container>
</header>
