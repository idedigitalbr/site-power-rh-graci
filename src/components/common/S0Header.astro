---
// S0Header.astro — Header institucional padronizado e orientado a dados
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { siteContent } from '../../data/siteContent';

interface Props {
  currentPage?: 'home' | 'sobre' | 'design-system';
}

const { currentPage = 'home' } = Astro.props;
const { navigation } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  {
    label: 'Home',
    href: currentPage === 'home' ? '#inicio' : `${base}/`,
    active: currentPage === 'home',
  },
  {
    label: 'Sobre',
    href: currentPage === 'sobre' ? '#inicio-sobre' : `${base}/sobre`,
    active: currentPage === 'sobre',
  },
  {
    label: 'Soluções',
    href: `${base}/#solucoes`,
    active: false,
  },
  {
    label: 'Contato',
    href: `${base}/#formulario-diagnostico`,
    active: false,
  },
];

const homeUrl = currentPage === 'home' ? '#inicio' : `${base}/`;
const ctaUrl = navigation.cta.href;
---

<header class="site-header-final">
  <Container size="wide">
    <nav class="site-nav-final" aria-label="Navegação Principal">
      <!-- Logo Institucional Oficial PowerRH -->
      <a href={homeUrl} class="brand-link-final" aria-label="PowerRH - Página Inicial">
        <img
          src={`${base}/assets/imagens-diversas/logo-powerrh.png`}
          alt="PowerRH — Pessoas que transformam negócios"
          class="brand-logo-img"
          width="180"
          height="46"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Menu de Links Dinâmicos -->
      <ul class="nav-links-final">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class={`nav-link-final ${link.active ? 'active' : ''}`.trim()}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA Principal Header -->
      <div>
        <Button href={ctaUrl} variant="gold" whatsapp={true}>
          {navigation.cta.text}
        </Button>
      </div>
    </nav>
  </Container>
</header>

<style>
  .brand-logo-img {
    height: 44px;
    width: auto;
    max-height: 48px;
    object-fit: contain;
    display: block;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .brand-link-final:hover .brand-logo-img {
    transform: scale(1.02);
    opacity: 0.95;
  }

  @media (max-width: 640px) {
    .brand-logo-img {
      height: 36px;
    }
  }
</style>
