---
interface Props {
  current?: 'final' | 'wireframe' | 'skeleton' | 'design-system';
}

const { current = 'final' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside class="sk-top-switcher" aria-label="Alternar Modo de Visualização">
  <a href={`${base}/skeleton`} class={current === 'skeleton' ? 'active' : ''} title="Visualização Blueprint Skeleton v0">👁️ Skeleton (v0)</a>
  <a href={`${base}/wireframe`} class={current === 'wireframe' ? 'active' : ''} title="Visualização Wireframe com Conteúdo v1">📄 Conteúdo (v1)</a>
  <a href={`${base}/`} class={current === 'final' ? 'active' : ''} title="Versão Final Pixel Perfect v2">✨ Versão Final (v2)</a>
  <a href={`${base}/design-system`} class={current === 'design-system' ? 'active' : ''} title="Biblioteca de Especificação e Tokens">📐 Design System</a>
</aside>
