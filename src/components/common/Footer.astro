---
// Footer.astro — Rodapé institucional oceânico padronizado e orientado a dados
import Container from '../ui/Container.astro';
import { siteContent } from '../../data/siteContent';

const { footer } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer-final">
  <Container size="wide">
    <div class="footer-main-grid-final">
      <!-- Coluna 1: Logo & Missão -->
      <div>
        <div class="footer-brand-title">{footer.brandTitle}</div>
        <p class="footer-brand-desc">
          {footer.brandDesc}
        </p>
        <div class="footer-social-row">
          <a
            href={footer.socialLinks[0].href}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-btn"
            aria-label="LinkedIn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a
            href={footer.socialLinks[1].href}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-btn"
            aria-label="Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>
      </div>

      <!-- Coluna 2: Navegação -->
      <div>
        <div class="footer-col-heading">Navegação</div>
        <ul class="footer-links-list">
          {footer.navLinks.map((link) => (
            <li class="footer-link-item">
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Coluna 3: Soluções -->
      <div>
        <div class="footer-col-heading">Soluções</div>
        <ul class="footer-links-list">
          {footer.solutionLinks.map((link) => (
            <li class="footer-link-item">
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Coluna 4: Contato -->
      <div>
        <div class="footer-col-heading">Contato</div>
        <div class="footer-contact-item-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span set:html={footer.contact.address.replace(' • ', '<br />')} />
        </div>
        <div class="footer-contact-item-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>{footer.contact.phone}</span>
        </div>
        <div class="footer-contact-item-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span>{footer.contact.email}</span>
        </div>
      </div>
    </div>

    <!-- Rodapé Inferior -->
    <div class="footer-bottom-bar">
      <div>{footer.copyright}</div>
      <div class="footer-bottom-links">
        <a href="#">Política de Privacidade</a>
        <span>•</span>
        <a href="#">Termos de Uso</a>
        <span>•</span>
        <a href={`${base}/design-system`} class="footer-ds-link" style="color: var(--color-gold); font-weight: 500;">
          📐 Design System
        </a>
      </div>
      <div>{footer.tagline}</div>
    </div>
  </Container>
</footer>
