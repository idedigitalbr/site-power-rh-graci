---
// contato.astro — Página Oficial de Contato e Diagnóstico Estratégico da PowerRH
import Layout from '../layouts/Layout.astro';
import S0Header from '../components/common/S0Header.astro';
import Footer from '../components/common/Footer.astro';
import Container from '../components/ui/Container.astro';
import GoldenArcs from '../components/ui/GoldenArcs.astro';
import { siteContent } from '../data/siteContent';

const { footer } = siteContent;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Contato e Diagnóstico Estratégico — PowerRH | Graciete Corrêa"
  description="Solicite uma reunião estratégica de diagnóstico com Graciete Corrêa, Advisor especialista em estratégia de negócios e pessoas."
>
  <S0Header currentPage="contato" />

  <main>
    <!-- S1: Hero Compacto de Abertura -->
    <section class="hero-final-section contato-hero-section" id="inicio-contato">
      <div class="hero-bg-media-layer" aria-hidden="true">
        <img
          src={`${base}/assets/imagens-diversas/fotos_graci_ia/07_CTA_FINAL_E_CONTATO/59_reuniao_fechamento.webp`}
          alt="Reunião estratégica de diagnóstico com a PowerRH"
          class="hero-bg-media-img is-active"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-bg-media-gradient"></div>
      </div>

      <GoldenArcs position="right" variant="arcs-right" />

      <Container size="wide" class="hero-container-relative">
        <div class="contato-hero-copy">
          <span class="hero-eyebrow-final">DIAGNÓSTICO ESTRATÉGICO</span>
          <h1 class="hero-title-final">
            Vamos conversar sobre<br />
            o <span class="highlight-gold">próximo ciclo da sua empresa.</span>
          </h1>
          <p class="hero-subtitle-final">
            Solicite uma reunião estratégica confidencial para analisar desafios de cultura, liderança, estrutura e sucessão com uma visão sistêmica do negócio.
          </p>
        </div>
      </Container>
    </section>

    <!-- S2: Formulário Completo + Confidencialidade e Contato Direto -->
    <section class="contato-main-section" id="formulario-diagnostico">
      <Container size="wide">
        <div class="contato-grid-layout">
          <!-- Coluna Esquerda: Formulário do Briefing -->
          <div class="contato-form-card">
            <div class="contato-form-header">
              <span class="contato-eyebrow">AGENDAMENTO EXECUTIVO</span>
              <h2 class="contato-form-title">Solicite uma Reunião de Diagnóstico</h2>
              <p class="contato-form-desc">
                Preencha os dados abaixo para contextualizar o momento da sua empresa antes da nossa conversa inicial.
              </p>
            </div>

            <form id="contato-diagnostico-form" class="contato-form-fields">
              <div class="contato-fields-row">
                <div class="contato-field-group">
                  <label for="contato-nome" class="contato-label">Nome do Proprietário / Diretor</label>
                  <input
                    type="text"
                    id="contato-nome"
                    name="nome"
                    placeholder="Seu nome completo"
                    class="contato-input"
                    required
                  />
                </div>

                <div class="contato-field-group">
                  <label for="contato-email" class="contato-label">E-mail Corporativo</label>
                  <input
                    type="email"
                    id="contato-email"
                    name="email"
                    placeholder="nome@suaempresa.com.br"
                    class="contato-input"
                    required
                  />
                </div>
              </div>

              <div class="contato-fields-row">
                <div class="contato-field-group">
                  <label for="contato-telefone" class="contato-label">Telefone / WhatsApp Direto</label>
                  <input
                    type="tel"
                    id="contato-telefone"
                    name="telefone"
                    placeholder="(00) 00000-0000"
                    class="contato-input"
                    required
                  />
                </div>

                <div class="contato-field-group">
                  <label for="contato-empresa" class="contato-label">Nome da Empresa</label>
                  <input
                    type="text"
                    id="contato-empresa"
                    name="empresa"
                    placeholder="Razão social ou nome fantasia"
                    class="contato-input"
                    required
                  />
                </div>
              </div>

              <div class="contato-fields-row">
                <div class="contato-field-group">
                  <label for="contato-colaboradores" class="contato-label">Número de Colaboradores</label>
                  <select id="contato-colaboradores" name="colaboradores" class="contato-select" required>
                    <option value="" disabled selected>Selecione o porte</option>
                    <option value="Até 30">Até 30</option>
                    <option value="De 31 a 100">De 31 a 100</option>
                    <option value="De 100 a 500">De 100 a 500</option>
                    <option value="Mais de 500">Mais de 500</option>
                  </select>
                </div>

                <div class="contato-field-group">
                  <label for="contato-desafio" class="contato-label">Maior desafio atual da empresa</label>
                  <select id="contato-desafio" name="desafio" class="contato-select" required>
                    <option value="" disabled selected>Selecione o desafio principal</option>
                    <option value="Reduzir a sobrecarga operacional do fundador">Reduzir a sobrecarga operacional do fundador</option>
                    <option value="Desenvolver a média liderança">Desenvolver a média liderança</option>
                    <option value="Iniciar ou organizar a sucessão familiar">Iniciar ou organizar a sucessão familiar</option>
                    <option value="Compreender e modelar a cultura organizacional">Compreender e modelar a cultura organizacional</option>
                    <option value="Melhorar o design organizacional, processos ou modelo de gestão">Melhorar o design organizacional, processos ou modelo de gestão</option>
                    <option value="Outro desafio estratégico">Outro desafio estratégico</option>
                  </select>
                </div>
              </div>

              <label class="contato-consent-row">
                <input type="checkbox" name="consentimento" required class="contato-checkbox" />
                <span>
                  Concordo com o tratamento dos meus dados para retorno deste contato, conforme a
                  <a href={`${base}/privacidade`} class="contato-inline-link">Política de Privacidade</a>
                  e o compromisso de confidencialidade da PowerRH.
                </span>
              </label>

              <button type="submit" class="contato-submit-btn">
                SOLICITAR REUNIÃO DE DIAGNÓSTICO →
              </button>

              <div id="contato-form-feedback" class="contato-feedback" role="status" aria-live="polite" hidden></div>
            </form>
          </div>

          <!-- Coluna Direita: Compromisso de Confidencialidade + Canais Oficiais -->
          <aside class="contato-aside-col">
            <div class="contato-sigilo-card">
              <div class="sigilo-badge-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <span class="contato-eyebrow-light">COMPROMISSO DE CONFIDENCIALIDADE</span>
              <h3 class="sigilo-title">Sigilo e discrição executiva desde o primeiro contato.</h3>
              <p class="sigilo-text">
                Todas as informações compartilhadas sobre estrutura societária, liderança, sucessão e momento do negócio são tratadas com ética, reserva e respeito absoluto pela Advisor Graciete Corrêa.
              </p>
              <a href={`${base}/privacidade`} class="sigilo-privacy-link">
                Ler Política de Privacidade →
              </a>
            </div>

            <div class="contato-direct-card">
              <span class="contato-eyebrow">ATENDIMENTO DIRETO</span>
              <h3 class="direct-title">Canais oficiais PowerRH</h3>

              <div class="direct-list">
                <a
                  href="https://wa.me/5591992992091?text=Ol%C3%A1%2C%20gostaria%20de+agendar+uma+reuni%C3%A3o+de+diagn%C3%B3stico+com+a+PowerRH."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="direct-item"
                >
                  <span class="direct-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                  </span>
                  <div>
                    <span class="direct-label">WhatsApp</span>
                    <strong class="direct-value">{footer.contact.phone}</strong>
                  </div>
                </a>

                <a href={`mailto:${footer.contact.email}`} class="direct-item">
                  <span class="direct-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  </span>
                  <div>
                    <span class="direct-label">E-mail</span>
                    <strong class="direct-value">{footer.contact.email}</strong>
                  </div>
                </a>

                <div class="direct-item is-static">
                  <span class="direct-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </span>
                  <div>
                    <span class="direct-label">Sede</span>
                    <strong class="direct-value">{footer.contact.address}</strong>
                  </div>
                </div>
              </div>

              <div class="direct-socials">
                <a
                  href={footer.socialLinks.find((s) => s.name === 'LinkedIn')?.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="direct-social-pill"
                >
                  LinkedIn ↗
                </a>
                <a
                  href={footer.socialLinks.find((s) => s.name === 'Instagram')?.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="direct-social-pill"
                >
                  Instagram ↗
                </a>
              </div>
            </div>
          </aside>
        </div>
      </Container>
    </section>
  </main>

  <Footer compactTop={true} />
</Layout>

<script is:inline>
  (() => {
    const initContatoForm = () => {
      const form = document.getElementById('contato-diagnostico-form');
      const feedback = document.getElementById('contato-form-feedback');
      if (!form || !feedback || form.dataset.initialized === 'true') return;
      form.dataset.initialized = 'true';

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;

        const data = new FormData(form);
        const nome = String(data.get('nome') || '').trim();
        const email = String(data.get('email') || '').trim();
        const telefone = String(data.get('telefone') || '').trim();
        const empresa = String(data.get('empresa') || '').trim();
        const colaboradores = String(data.get('colaboradores') || '').trim();
        const desafio = String(data.get('desafio') || '').trim();

        const mensagem = [
          'Olá, Graciete! Gostaria de solicitar uma Reunião de Diagnóstico pela PowerRH.',
          '',
          `*Nome:* ${nome}`,
          `*E-mail Corporativo:* ${email}`,
          `*Telefone/WhatsApp:* ${telefone}`,
          `*Empresa:* ${empresa}`,
          `*Colaboradores:* ${colaboradores}`,
          `*Maior desafio atual:* ${desafio}`,
        ].join('\n');

        const waUrl = `https://wa.me/5591992992091?text=${encodeURIComponent(mensagem)}`;
        const opened = window.open(waUrl, '_blank', 'noopener,noreferrer');

        feedback.hidden = false;
        feedback.innerHTML = '';
        const textNode = document.createTextNode('Solicitação preparada com os dados da sua empresa. ');
        const link = document.createElement('a');
        link.href = waUrl;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.className = 'contato-feedback-link';
        link.textContent = opened ? 'Abrir WhatsApp novamente →' : 'Clique aqui para enviar pelo WhatsApp →';
        feedback.appendChild(textNode);
        feedback.appendChild(link);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContatoForm);
    } else {
      initContatoForm();
    }
    document.addEventListener('astro:page-load', initContatoForm);
  })();
</script>

<style>
  .contato-hero-section {
    min-height: clamp(360px, 46vh, 450px);
    padding: 130px 0 70px;
  }

  .contato-hero-copy {
    max-width: 660px;
    position: relative;
    z-index: 3;
  }

  .contato-main-section {
    background: #FCFAF7;
    padding: 72px 0 88px;
  }

  .contato-grid-layout {
    display: grid;
    grid-template-columns: 1.35fr 0.9fr;
    gap: 36px;
    align-items: start;
  }

  .contato-form-card {
    background: #FFFFFF;
    border: 1px solid #EDE7DD;
    border-radius: 22px;
    padding: 36px 34px;
    box-shadow: 0 12px 30px rgba(1, 36, 62, 0.06);
  }

  .contato-eyebrow {
    display: block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #9A621D;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .contato-eyebrow-light {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #C88A3B;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .contato-form-title {
    font-size: clamp(24px, 2.3vw, 30px);
    font-weight: 800;
    color: #01243E;
    line-height: 1.2;
    margin: 0 0 10px;
  }

  .contato-form-desc {
    font-size: 15px;
    color: #4A5568;
    line-height: 1.6;
    margin: 0 0 26px;
  }

  .contato-form-fields {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contato-fields-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .contato-field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contato-label {
    font-size: 13px;
    font-weight: 700;
    color: #1E293B;
  }

  .contato-input,
  .contato-select {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    border: 1px solid #D8DEE6;
    border-radius: 10px;
    background: #FCFAF7;
    color: #0F172A;
    font-size: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .contato-input:focus,
  .contato-select:focus {
    outline: none;
    border-color: #C88A3B;
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(200, 138, 59, 0.16);
  }

  .contato-consent-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: #475569;
    line-height: 1.5;
    cursor: pointer;
    margin-top: 4px;
  }

  .contato-checkbox {
    margin-top: 3px;
    accent-color: #C88A3B;
    flex-shrink: 0;
  }

  .contato-inline-link {
    color: #9A621D;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .contato-submit-btn {
    margin-top: 6px;
    width: 100%;
    padding: 15px 24px;
    border: none;
    border-radius: 9999px;
    background: linear-gradient(135deg, #CB9857 0%, #B87B2E 100%);
    color: #FFFFFF;
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 0 8px 22px -4px rgba(184, 123, 46, 0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contato-submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -4px rgba(184, 123, 46, 0.55);
  }

  .contato-feedback {
    padding: 14px 16px;
    border-radius: 12px;
    background: #FDF6EC;
    border: 1px solid rgba(200, 138, 59, 0.5);
    color: #01243E;
    font-size: 13.5px;
    line-height: 1.5;
  }

  .contato-feedback[hidden] {
    display: none;
  }

  .contato-feedback-link {
    color: #9A621D;
    font-weight: 800;
    text-decoration: underline;
  }

  .contato-aside-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contato-sigilo-card {
    background: #01243E;
    color: #FFFFFF;
    border-radius: 22px;
    padding: 30px 28px;
    border: 1px solid rgba(200, 138, 59, 0.35);
    box-shadow: 0 16px 36px rgba(1, 36, 62, 0.16);
  }

  .sigilo-badge-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(200, 138, 59, 0.16);
    color: #C88A3B;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .sigilo-title {
    font-size: 20px;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.3;
    margin: 0 0 12px;
  }

  .sigilo-text {
    font-size: 14px;
    color: #CBD5E1;
    line-height: 1.62;
    margin: 0 0 16px;
  }

  .sigilo-privacy-link {
    color: #E2B777;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .sigilo-privacy-link:hover {
    text-decoration: underline;
  }

  .contato-direct-card {
    background: #FFFFFF;
    border: 1px solid #EDE7DD;
    border-radius: 22px;
    padding: 28px;
    box-shadow: 0 8px 24px rgba(1, 36, 62, 0.05);
  }

  .direct-title {
    font-size: 19px;
    font-weight: 800;
    color: #01243E;
    margin: 0 0 18px;
  }

  .direct-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .direct-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: #FAF7F2;
    border: 1px solid #EDE7DD;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .direct-item:not(.is-static):hover {
    border-color: #C88A3B;
    transform: translateY(-2px);
  }

  .direct-icon {
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    background: #FDF6EC;
    color: #9A621D;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .direct-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748B;
  }

  .direct-value {
    font-size: 14px;
    font-weight: 700;
    color: #01243E;
  }

  .direct-socials {
    display: flex;
    gap: 10px;
    margin-top: 16px;
  }

  .direct-social-pill {
    flex: 1;
    text-align: center;
    padding: 10px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(200, 138, 59, 0.4);
    color: #9A621D;
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .direct-social-pill:hover {
    background: #C88A3B;
    color: #FFFFFF;
    border-color: #C88A3B;
  }

  @media (max-width: 960px) {
    .contato-grid-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .contato-hero-section {
      padding: 110px 0 54px;
    }

    .contato-main-section {
      padding: 44px 0 64px;
    }

    .contato-form-card {
      padding: 26px 20px;
    }

    .contato-fields-row {
      grid-template-columns: 1fr;
    }
  }
</style>
