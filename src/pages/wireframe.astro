---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="PowerRH — Consultoria Estratégica em Pessoas | Wireframe com Conteúdo"
  currentView="wireframe"
  includeFinalCss={false}
>
<!-- Switcher de Navegação Rápida entre as 4 Visões -->
  

  <!-- =========================================================================
       HEADER INSTITUCIONAL & NAVEGAÇÃO
       ========================================================================= -->
  <header class="site-header">
    <div class="container container-wide">
      <nav class="site-nav" aria-label="Navegação Principal">
        <a href="#inicio" class="nav-brand">
          <div class="brand-icon-box">PR</div>
          <div class="brand-text-block">
            <span class="brand-name">PowerRH</span>
            <span class="brand-tagline">Pessoas que transformam negócios</span>
          </div>
        </a>

        <ul class="nav-menu">
          <li><a href="#inicio" class="nav-link active">Início</a></li>
          <li><a href="#sobre" class="nav-link">Sobre</a></li>
          <li><a href="#solucoes" class="nav-link">Soluções</a></li>
          <li><a href="#diferenciais" class="nav-link">Diferenciais</a></li>
          <li><a href="#depoimentos" class="nav-link">Depoimentos</a></li>
          <li><a href="#faq" class="nav-link">FAQ</a></li>
        </ul>

        <div class="nav-actions">
          <a href="#formulario-diagnostico" class="btn btn-primary btn-sm">
            Falar com a especialista →
          </a>
          <button type="button" class="mobile-menu-btn" id="mobileMenuToggle" aria-label="Abrir Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          </button>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <!-- =======================================================================
         SEÇÃO 01: HERO SECTION
         ======================================================================= -->
    <section class="section" id="inicio">
      <div class="container container-wide">
        <div class="hero-wireframe-grid">
          
          <!-- Coluna 1: Headline, Copywriting e CTA -->
          <div>
            <span class="section-eyebrow">CONSULTORIA ESTRATÉGICA EM PESSOAS</span>
            <h1 class="section-title" style="font-size: clamp(2.2rem, 3.8vw, 3.5rem); margin-bottom: var(--space-4);">
              Empresas crescem quando pessoas evoluem.
            </h1>
            <p class="section-subtitle" style="margin-bottom: var(--space-6);">
              Estratégia, liderança e cultura para transformar o potencial humano em resultados reais e sustentáveis.
            </p>

            <div>
              <a href="#formulario-diagnostico" class="btn btn-primary btn-lg">
                Quero um diagnóstico gratuito →
              </a>
            </div>

            <!-- Mini-badges de Benefícios Rápidos com Ícones -->
            <div class="hero-feature-badges">
              <div class="hero-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                <span>Visão estratégica</span>
              </div>
              <div class="hero-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                <span>Foco em resultados</span>
              </div>
              <div class="hero-feature-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span>Parceria de longo prazo</span>
              </div>
            </div>
          </div>

          <!-- Coluna 2: Foto Real da Fundadora Graciete Corrêa -->
          <div>
            <div class="hero-photo-wrapper">
              <img src={`${base}/assets/imagens-diversas/fotos_graci_ia/01_HOME_HERO_TOPO/01_retrato_executivo_com_vista_para_o_rio.webp`} alt="Graciete Corrêa - Fundadora PowerRH" class="hero-photo-img">
              <div class="hero-photo-tag">
                Graciete Corrêa — FUNDADORA POWER RH
              </div>
            </div>
          </div>

          <!-- Coluna 3: Card de Formulário de Conversão -->
          <div id="formulario-diagnostico">
            <div class="form-card">
              <div style="margin-bottom: var(--space-5);">
                <h3 style="font-size: var(--font-size-lg); margin-bottom: var(--space-1); color: var(--text-primary);">
                  Fale com a nossa especialista
                </h3>
                <p style="font-size: var(--font-size-xs); color: var(--text-muted); margin: 0;">
                  Receba um diagnóstico inicial para a sua empresa.
                </p>
              </div>

              <form action="#" method="POST" onsubmit="event.preventDefault(); alert('Solicitação de diagnóstico recebida com sucesso!');">
                <div class="form-group">
                  <label class="form-label" for="hero-nome">Seu nome</label>
                  <input type="text" id="hero-nome" class="form-control" placeholder="Seu nome completo" required>
                </div>

                <div class="form-group">
                  <label class="form-label" for="hero-email">E-mail corporativo</label>
                  <input type="email" id="hero-email" class="form-control" placeholder="nome@empresa.com.br" required>
                </div>

                <div class="form-group">
                  <label class="form-label" for="hero-telefone">Telefone / WhatsApp</label>
                  <input type="tel" id="hero-telefone" class="form-control" placeholder="(00) 00000-0000" required>
                </div>

                <div class="form-group">
                  <label class="form-label" for="hero-empresa">Nome da empresa</label>
                  <input type="text" id="hero-empresa" class="form-control" placeholder="Nome da organização" required>
                </div>

                <div class="form-group">
                  <label class="form-label" for="hero-ajuda">Como podemos ajudar?</label>
                  <select id="hero-ajuda" class="form-select" required>
                    <option value="">Como podemos ajudar?</option>
                    <option value="cultura">Cultura & Estrutura Organizacional</option>
                    <option value="lideranca">Liderança & Desenvolvimento</option>
                    <option value="governanca">Governança & Sucessão Familiar</option>
                    <option value="outro">Outro desafio de RH Estratégico</option>
                  </select>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; margin-top: var(--space-2);">
                  Solicitar diagnóstico →
                </button>

                <div class="form-security-note">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                  Seus dados estão seguros conosco.
                </div>
              </form>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =======================================================================
         SEÇÃO 02: NÚMEROS & PROVA RÁPIDA (MÉTRICAS)
         ======================================================================= -->
    <section class="section-compact" style="padding-top: 0;">
      <div class="container container-wide">
        <div class="card-metric-bar">
          <div class="metric-item">
            <div class="metric-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div>
              <div class="metric-value">+120</div>
              <div class="metric-label">empresas atendidas</div>
            </div>
          </div>

          <div class="metric-item">
            <div class="metric-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <div>
              <div class="metric-value">+9.000</div>
              <div class="metric-label">pessoas desenvolvidas</div>
            </div>
          </div>

          <div class="metric-item">
            <div class="metric-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </div>
            <div>
              <div class="metric-value">95%</div>
              <div class="metric-label">de satisfação dos clientes</div>
            </div>
          </div>

          <div class="metric-item">
            <div class="metric-icon-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            </div>
            <div>
              <div class="metric-value">+15 anos</div>
              <div class="metric-label">de experiência em gestão de pessoas</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =======================================================================
         SEÇÃO 03: QUANDO É HORA DE CONTAR COM APOIO ESTRATÉGICO?
         ======================================================================= -->
    <section class="section">
      <div class="container container-wide">
        <div class="section-header-center">
          <span class="section-eyebrow">QUANDO É HORA</span>
          <h2 class="section-title">Quando é hora de contar com apoio estratégico?</h2>
        </div>

        <div class="trigger-grid">
          <div class="card-trigger">
            <div class="card-trigger-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <p class="card-trigger-text">
              Sua empresa está crescendo e precisa estruturar a área de pessoas.
            </p>
          </div>

          <div class="card-trigger">
            <div class="card-trigger-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            </div>
            <p class="card-trigger-text">
              Há desafios de liderança ou de cultura que impactam os resultados.
            </p>
          </div>

          <div class="card-trigger">
            <div class="card-trigger-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            </div>
            <p class="card-trigger-text">
              É momento de preparar a sucessão e garantir a continuidade do negócio.
            </p>
          </div>

          <div class="card-trigger">
            <div class="card-trigger-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </div>
            <p class="card-trigger-text">
              Você quer levar sua empresa a um novo patamar com um time mais forte e engajado.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =======================================================================
         SEÇÃO 04: NOSSAS SOLUÇÕES
         ======================================================================= -->
    <section class="section section-subtle" id="solucoes">
      <div class="container container-wide">
        <div class="section-header-center">
          <span class="section-eyebrow">NOSSAS SOLUÇÕES</span>
          <h2 class="section-title">Estratégia em pessoas para cada etapa do seu crescimento.</h2>
        </div>

        <div class="solutions-grid">
          <!-- Card 1: Cultura & Estrutura -->
          <article class="card-solution">
            <div class="card-solution-image-wrap">
              <img src={`${base}/assets/imagens-diversas/fotos_graci_ia/03_SOLUCAO_CULTURA_E_ESTRUTURA/21_diagnostico_de_cultura.webp`} alt="Cultura e Estrutura Organizacional" class="card-solution-image">
            </div>
            <div class="card-solution-bar">
              <div class="card-solution-info">
                <div class="card-solution-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <h3 class="card-solution-title">Cultura & Estrutura</h3>
              </div>
              <a href="#formulario-diagnostico" class="card-solution-arrow" aria-label="Saiba mais sobre Cultura e Estrutura">→</a>
            </div>
          </article>

          <!-- Card 2: Liderança & Desenvolvimento -->
          <article class="card-solution">
            <div class="card-solution-image-wrap">
              <img src={`${base}/assets/imagens-diversas/fotos_graci_ia/04_SOLUCAO_LIDERANCA_E_DESENVOLVIMENTO/08_lideranca_people_culture.webp`} alt="Liderança e Desenvolvimento de Gestores" class="card-solution-image">
            </div>
            <div class="card-solution-bar">
              <div class="card-solution-info">
                <div class="card-solution-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                </div>
                <h3 class="card-solution-title">Liderança & Desenvolvimento</h3>
              </div>
              <a href="#formulario-diagnostico" class="card-solution-arrow" aria-label="Saiba mais sobre Liderança e Desenvolvimento">→</a>
            </div>
          </article>

          <!-- Card 3: Governança & Sucessão -->
          <article class="card-solution">
            <div class="card-solution-image-wrap">
              <img src={`${base}/assets/imagens-diversas/fotos_graci_ia/05_SOLUCAO_GOVERNANCA_E_SUCESSAO/41_fundador_e_sucessor.webp`} alt="Governança e Sucessão Familiar" class="card-solution-image">
            </div>
            <div class="card-solution-bar">
              <div class="card-solution-info">
                <div class="card-solution-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                </div>
                <h3 class="card-solution-title">Governança & Sucessão</h3>
              </div>
              <a href="#formulario-diagnostico" class="card-solution-arrow" aria-label="Saiba mais sobre Governança e Sucessão">→</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- =======================================================================
         SEÇÃO 05: COMO TRABALHAMOS (MÉTODO EM 4 ETAPAS)
         ======================================================================= -->
    <section class="section">
      <div class="container container-wide">
        <div class="section-header">
          <span class="section-eyebrow">COMO TRABALHAMOS</span>
          <h2 class="section-title">Um processo claro, próximo e eficaz.</h2>
        </div>

        <div class="steps-wrapper">
          <div class="steps-grid">
            <div class="step-card">
              <div class="step-badge">01</div>
              <h3 class="step-title">Diagnóstico</h3>
              <p class="step-desc">Entendemos sua realidade e desafios organizacionais.</p>
            </div>

            <div class="step-card">
              <div class="step-badge">02</div>
              <h3 class="step-title">Planejamento</h3>
              <p class="step-desc">Desenhamos soluções personalizadas para o seu momento.</p>
            </div>

            <div class="step-card">
              <div class="step-badge">03</div>
              <h3 class="step-title">Implementação</h3>
              <p class="step-desc">Colocamos o plano em prática, lado a lado com sua equipe.</p>
            </div>

            <div class="step-card">
              <div class="step-badge">04</div>
              <h3 class="step-title">Evolução</h3>
              <p class="step-desc">Acompanhamos resultados e fazemos ajustes contínuos.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =======================================================================
         SEÇÃO 06: SOBRE A FUNDADORA (GRACIETE CORRÊA)
         ======================================================================= -->
    <section class="section section-subtle" id="sobre">
      <div class="container container-wide">
        <div class="sobre-layout-grid">
          
          <!-- Foto Oficial de Graciete Corrêa -->
          <div class="sobre-photo-box">
            <img src={`${base}/assets/imagens-diversas/fotos_graci_ia/02_SOBRE_GRACIETE/Imagem do ChatGPT 7 de out. de 2026, 19_04_42-2.webp`} alt="Graciete Corrêa - Especialista em Estratégia de Pessoas">
          </div>

          <!-- Biografia e Credenciais -->
          <div>
            <span class="section-eyebrow">SOBRE A FUNDADORA</span>
            <h2 class="section-title" style="margin-bottom: var(--space-1);">Graciete Corrêa</h2>
            <div style="font-size: var(--font-size-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-4);">
              ESPECIALISTA EM ESTRATÉGIA DE PESSOAS
            </div>

            <p style="font-size: var(--font-size-base); color: var(--text-secondary); line-height: 1.7; margin-bottom: var(--space-6);">
              Mais de 15 anos de experiência em desenvolvimento organizacional, liderança e cultura. Minha trajetória é movida pela crença de que pessoas, quando bem cuidadas e desenvolvidas, constroem empresas mais fortes, humanas e prósperas.
            </p>

            <a href="#formulario-diagnostico" class="btn btn-primary">
              Conheça minha história →
            </a>
          </div>

          <!-- 4 Credenciais com Ícones -->
          <div class="sobre-credentials-grid">
            <div class="credential-item">
              <div class="credential-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <div class="credential-text">15+ anos de experiência</div>
            </div>

            <div class="credential-item">
              <div class="credential-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              </div>
              <div class="credential-text">Centenas de líderes desenvolvidos</div>
            </div>

            <div class="credential-item">
              <div class="credential-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              </div>
              <div class="credential-text">Projetos em diversos setores</div>
            </div>

            <div class="credential-item">
              <div class="credential-icon">
