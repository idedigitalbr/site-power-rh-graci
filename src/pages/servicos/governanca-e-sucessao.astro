---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const destination = `${base}/servicos/advisory-negocios-cultura`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex,follow" />
    <title>Nova página de soluções — PowerRH</title>
    <link rel="canonical" href={`https://idedigitalbr.github.io${destination}`} />
  </head>
  <body>
    <p>Esta solução agora faz parte de um dos três pilares oficiais da PowerRH. <a href={destination}>Acessar a página atualizada</a>.</p>
  </body>
</html>
