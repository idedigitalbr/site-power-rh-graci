---
// cultura-organizacional.astro — Página Oficial da Solução 01: Cultura & Design Organizacional
import Layout from '../../layouts/Layout.astro';
import S0Header from '../../components/common/S0Header.astro';
import Footer from '../../components/common/Footer.astro';

// Componentes Editoriais de Alto Padrão
import ServicoHero from '../../components/servicos/ServicoHero.astro';
import ServicosNavSelector from '../../components/servicos/ServicosNavSelector.astro';
import ServicoEditorialStory from '../../components/servicos/ServicoEditorialStory.astro';
import ServicoPilaresMinimal from '../../components/servicos/ServicoPilaresMinimal.astro';
import ServicoAutoridadeMetodo from '../../components/servicos/ServicoAutoridadeMetodo.astro';

// Seções de Prova Social e Conversão da Home
import S8Depoimentos from '../../components/home/S8Depoimentos.astro';
import S10CtaBanner from '../../components/home/S10CtaBanner.astro';

import { siteContent } from '../../data/siteContent';

const service = siteContent.servicos['cultura-organizacional'];
---

<Layout
  title={service.meta.title}
  description={service.meta.description}
>
  <S0Header currentPage="servicos" />

  <main>
    <!-- 1. Topo Hero Panorâmico Oficial (Contraste Perfeito e Foto Executiva) -->
    <ServicoHero service={service} />

    <!-- 2. Barra de Navegação Rápida entre as Soluções -->
    <ServicosNavSelector currentSlug={service.slug} />

    <!-- 3. Narrativa Editorial: O Momento do Negócio & O Desafio Estratégico -->
    <ServicoEditorialStory service={service} />

    <!-- 4. Os 3 Pilares Centrais de Entrega (Design Enxuto e Respirável) -->
    <ServicoPilaresMinimal service={service} />

    <!-- 5. Autoridade Executiva de Graciete Corrêa & Fases do Método -->
    <ServicoAutoridadeMetodo service={service} />

    <!-- 6. Prova Social (Depoimentos Oficiais da Home) -->
    <S8Depoimentos />

    <!-- 7. Banner Comercial de Conversão (Reaproveitamento da Home) -->
    <S10CtaBanner />
  </main>

  <Footer />
</Layout>
