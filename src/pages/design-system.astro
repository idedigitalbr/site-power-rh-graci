---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="PowerRH — Design System Preview & Especificação Visual"
  currentView="design-system"
  includeFinalCss={false}
>
  <style is:inline>
/* Estilos específicos para layout da documentação do preview */
    .ds-preview-nav {
      position: sticky;
      top: 0;
      z-index: var(--z-header);
      background-color: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-hairline);
      height: 72px;
      display: flex;
      align-items: center;
    }

    .ds-preview-hero {
      background-color: var(--bg-surface-subtle);
      border-bottom: 1px solid var(--border-hairline);
      padding: var(--space-16) 0 var(--space-12);
    }

    .ds-toc {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-top: var(--space-6);
    }

    .ds-toc a {
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
      color: var(--text-secondary);
      background-color: var(--bg-surface);
      border: 1px solid var(--border-default);
      padding: 6px 14px;
      border-radius: var(--radius-full);
      transition: all var(--transition-fast);
    }

    .ds-toc a:hover {
      background-color: var(--color-gray-900);
      color: var(--color-white);
      border-color: var(--color-gray-900);
    }

    .swatch-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-4);
    }

    .swatch-card {
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-lg);
      background-color: var(--bg-surface);
      overflow: hidden;
      box-shadow: var(--shadow-xs);
      transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    }

    .swatch-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .swatch-color {
      height: 80px;
      width: 100%;
      border-bottom: 1px solid var(--border-hairline);
    }

    .swatch-body {
      padding: var(--space-3);
    }

    .swatch-name {
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      color: var(--text-primary);
      margin-bottom: 2px;
    }

    .swatch-hex {
      font-family: var(--font-family-mono);
      font-size: 11px;
      color: var(--text-muted);
    }

    .swatch-role {
      font-size: 11px;
      color: var(--text-secondary);
      margin-top: 4px;
      line-height: 1.3;
    }

    /* Tabela Tipográfica */
    .type-specimen-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: var(--space-6);
      background-color: var(--bg-surface);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }

    .type-specimen-table th {
      text-align: left;
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: var(--letter-spacing-wide);
      color: var(--text-muted);
      padding: 12px 16px;
      background-color: var(--bg-surface-subtle);
      border-bottom: 1px solid var(--border-hairline);
    }

    .type-specimen-table td {
      padding: 16px;
      border-bottom: 1px solid var(--border-hairline);
      vertical-align: middle;
    }

    .type-token-badge {
      font-family: var(--font-family-mono);
      font-size: 11px;
      background-color: var(--bg-surface-muted);
      border: 1px solid var(--border-default);
      padding: 3px 8px;
      border-radius: var(--radius-xs);
      color: var(--text-primary);
      white-space: nowrap;
    }

    /* Espaçamentos e Sombras Visuais */
    .space-ruler {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .space-row {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      background-color: var(--bg-surface);
      padding: var(--space-2) var(--space-4);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-md);
    }

    .space-meta {
      width: 140px;
      font-family: var(--font-family-mono);
      font-size: 12px;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .space-bar {
      height: 18px;
      background-color: var(--color-gray-900);
      border-radius: var(--radius-xs);
    }

    .shadow-showcase-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-4);
    }

    .shadow-box {
      background-color: var(--bg-surface);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      text-align: center;
      border: 1px solid var(--border-hairline);
    }

    .shadow-box p {
      font-family: var(--font-family-mono);
      font-size: 12px;
      margin-top: var(--space-2);
      color: var(--text-muted);
    }

    .comp-panel {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-hairline);
      border-radius: var(--radius-xl);
      padding: var(--space-8);
      margin-bottom: var(--space-8);
      box-shadow: var(--shadow-xs);
    }

    .comp-panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-6);
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--border-hairline);
    }

    .comp-panel-title {
      font-size: var(--font-size-md);
      font-weight: var(--font-weight-bold);
      color: var(--text-primary);
    }

    .comp-demo-row {
      display: flex;
      gap: var(--space-4);
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: var(--space-4);
    }
  </style>

<!-- Switcher de Navegação Rápida entre as 4 Visões -->
  

  <!-- =========================================================================
       TOP STICKY NAVBAR DO DESIGN SYSTEM
       ========================================================================= -->
  <header class="ds-preview-nav">
    <div class="container container-wide">
      <div class="site-nav">
        <a href="#inicio" class="nav-brand">
          <div class="brand-icon-box">PR</div>
          <div class="brand-text-block">
            <span class="brand-name">PowerRH</span>
            <span class="brand-tagline">Design System Preview</span>
          </div>
        </a>

        <div class="nav-actions">
          <span class="badge">
            <span class="badge-dot"></span>
            v1.0.0 • Wireframe Neutro
          </span>
          <a href="index-wireframe.html" class="btn btn-primary btn-sm">
            Ver Wireframe Completo →
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       HERO BANNER DA ESPECIFICAÇÃO
       ========================================================================= -->
  <section class="ds-preview-hero" id="inicio">
    <div class="container container-wide">
      <span class="section-eyebrow">Arquitetura de Interface & Biblioteca Canônica</span>
      <h1 class="section-title">Design System & Especificação Visual</h1>
      <p class="section-subtitle">
        Documentação viva e funcional dos tokens semânticos, tipografia, escala modular e componentes reutilizáveis construídos para a <strong>PowerRH (Graciete Corrêa)</strong>.
      </p>

      <div class="ds-toc">
        <a href="#cores">01. Cores & Tokens</a>
        <a href="#tipografia">02. Tipografia & Escala</a>
        <a href="#espacamento">03. Espaçamentos & Raios</a>
        <a href="#botoes">04. Botões & Badges</a>
        <a href="#formularios">05. Formulários</a>
        <a href="#cards">06. Cards & Grids</a>
        <a href="#metodo">07. Processo / Método</a>
        <a href="#faq">08. Acordeão & FAQ</a>
        <a href="#navegacao">09. Header & Rodapé</a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       01. PALETA DE CORES & TOKENS SEMÂNTICOS
       ========================================================================= -->
  <section class="section" id="cores">
    <div class="container container-wide">
      <div class="section-header">
        <span class="section-eyebrow">Seção 01</span>
        <h2 class="section-title">Paleta de Cores e Tokens Semânticos</h2>
        <p class="section-subtitle">
          Na fase de wireframe, a paleta é composta estritamente por valores acromáticos calibrados para garantir contraste WCAG AA, hierarquia de leitura e transição transparente para a identidade final.
        </p>
      </div>

      <h3 style="font-size: var(--font-size-md); margin-bottom: var(--space-4); color: var(--text-secondary);">Escala Neutra Primitiva (Gray Scale)</h3>
      <div class="swatch-grid" style="margin-bottom: var(--space-8);">
        <div class="swatch-card">
          <div class="swatch-color" style="background-color: var(--color-white);"></div>
          <div class="swatch-body">
            <div class="swatch-name">--color-white</div>
            <div class="swatch-hex">#FFFFFF</div>
            <div class="swatch-role">Superfície base & Fundo claro</div>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background-color: var(--color-gray-50);"></div>
          <div class="swatch-body">
            <div class="swatch-name">--color-gray-50</div>
            <div class="swatch-hex">#F8F9FA</div>
            <div class="swatch-role">Fundo suave alternado</div>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background-color: var(--color-gray-100);"></div>
          <div class="swatch-body">
            <div class="swatch-name">--color-gray-100</div>
            <div class="swatch-hex">#F1F3F5</div>
            <div class="swatch-role">Inputs e chips neutros</div>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background-color: var(--color-gray-200);"></div>
          <div class="swatch-body">
            <div class="swatch-name">--color-gray-200</div>
            <div class="swatch-hex">#E9ECEF</div>
            <div class="swatch-role">Linhas divisórias (Hairline)</div>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background-color: var(--color-gray-300);"></div>
          <div class="swatch-body">
            <div class="swatch-name">--color-gray-300</div>
            <div class="swatch-hex">#DEE2E6</div>
            <div class="swatch-role">Bordas padrão de cards</div>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background-color: var(--color-gray-500);"></div>
          <div class="swatch-body">
            <div class="swatch-name">--color-gray-500</div>
            <div class="swatch-hex">#ADB5BD</div>
            <div class="swatch-role">Textos atenuados (Muted)</div>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background-color: var(--color-gray-700);"></div>
          <div class="swatch-body">
            <div class="swatch-name">--color-gray-700</div>
            <div class="swatch-hex">#495057</div>
            <div class="swatch-role">Textos secundários de leitura</div>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background-color: var(--color-gray-900);"></div>
          <div class="swatch-body">
            <div class="swatch-name">--color-gray-900</div>
            <div class="swatch-hex">#212529</div>
            <div class="swatch-role">Títulos principais & CTA primário</div>
          </div>
        </div>

        <div class="swatch-card">
          <div class="swatch-color" style="background-color: var(--color-gray-950);"></div>
          <div class="swatch-body">
            <div class="swatch-name">--color-gray-950</div>
            <div class="swatch-hex">#121416</div>
            <div class="swatch-role">Rodapé & Superfície profunda</div>
          </div>
        </div>
      </div>

      <h3 style="font-size: var(--font-size-md); margin-bottom: var(--space-4); color: var(--text-secondary);">Mapeamento Semântico de Aplicação</h3>
      <div class="comp-panel">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4);">
          <div style="padding: var(--space-4); background-color: var(--bg-surface-subtle); border-radius: var(--radius-md); border-left: 4px solid var(--color-gray-900);">
            <div class="font-mono" style="font-size: 12px; font-weight: 700;">--action-primary-bg</div>
            <div style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;">Fundo do botão principal de conversão</div>
          </div>
          <div style="padding: var(--space-4); background-color: var(--bg-surface-subtle); border-radius: var(--radius-md); border-left: 4px solid var(--color-gray-400);">
            <div class="font-mono" style="font-size: 12px; font-weight: 700;">--border-default</div>
            <div style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;">Delimitação padrão de cartões e inputs</div>
          </div>
          <div style="padding: var(--space-4); background-color: var(--bg-surface-subtle); border-radius: var(--radius-md); border-left: 4px solid var(--color-gray-900);">
            <div class="font-mono" style="font-size: 12px; font-weight: 700;">--bg-inverse</div>
            <div style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;">Planos de fundo de banners de impacto</div>
          </div>
          <div style="padding: var(--space-4); background-color: var(--bg-surface-subtle); border-radius: var(--radius-md); border-left: 4px solid var(--color-gray-500);">
            <div class="font-mono" style="font-size: 12px; font-weight: 700;">--text-muted</div>
            <div style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;">Legendas e anotações complementares</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       02. TIPOGRAFIA & HIERARQUIA VISUAL
       ========================================================================= -->
  <section class="section section-subtle" id="tipografia">
    <div class="container container-wide">
      <div class="section-header">
        <span class="section-eyebrow">Seção 02</span>
        <h2 class="section-title">Tipografia & Hierarquia Visual</h2>
        <p class="section-subtitle">
          Construída sobre a família tipográfica <strong>Inter</strong>, proporcionando legibilidade técnica e clareza visual corporativa para consultoria estratégica executiva.
        </p>
      </div>

      <div class="comp-panel">
        <div class="comp-panel-header">
          <span class="comp-panel-title">Amostrador de Pesos e Estilos</span>
          <span class="badge">Família: Inter</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: var(--space-3);">
          <div style="font-weight: 400; font-size: var(--font-size-lg);">Inter Regular 400 — Empresas crescem quando pessoas evoluem com método e governança.</div>
          <div style="font-weight: 500; font-size: var(--font-size-lg);">Inter Medium 500 — Empresas crescem quando pessoas evoluem com método e governança.</div>
          <div style="font-weight: 600; font-size: var(--font-size-lg);">Inter Semibold 600 — Empresas crescem quando pessoas evoluem com método e governança.</div>
          <div style="font-weight: 700; font-size: var(--font-size-lg);">Inter Bold 700 — Empresas crescem quando pessoas evoluem com método e governança.</div>
          <div style="font-weight: 800; font-size: var(--font-size-lg);">Inter Extrabold 800 — Empresas crescem quando pessoas evoluem com método e governança.</div>
        </div>
      </div>

      <table class="type-specimen-table">
        <thead>
          <tr>
            <th>Token</th>
            <th>Tamanho (rem / px)</th>
            <th>Leading</th>
            <th>Exemplo & Aplicação Real</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span class="type-token-badge">--font-size-5xl</span></td>
            <td>3.50rem / 56px</td>
            <td>1.15</td>
            <td><h1 style="font-size: var(--font-size-5xl); margin: 0;">Empresas crescem.</h1></td>
          </tr>
          <tr>
            <td><span class="type-token-badge">--font-size-4xl</span></td>
            <td>2.875rem / 46px</td>
            <td>1.15</td>
            <td><h2 style="font-size: var(--font-size-4xl); margin: 0;">Pessoas evoluem.</h2></td>
          </tr>
          <tr>
            <td><span class="type-token-badge">--font-size-3xl</span></td>
            <td>2.25rem / 36px</td>
            <td>1.30</td>
            <td><h3 style="font-size: var(--font-size-3xl); margin: 0;">Um processo claro, próximo e eficaz.</h3></td>
          </tr>
          <tr>
            <td><span class="type-token-badge">--font-size-2xl</span></td>
            <td>1.875rem / 30px</td>
            <td>1.30</td>
            <td><div style="font-size: var(--font-size-2xl); font-weight: 800;">+9.000 pessoas desenvolvidas</div></td>
          </tr>
          <tr>
            <td><span class="type-token-badge">--font-size-xl</span></td>
            <td>1.50rem / 24px</td>
            <td>1.30</td>
            <td><div style="font-size: var(--font-size-xl); font-weight: 700;">Graciete Corrêa</div></td>
          </tr>
          <tr>
            <td><span class="type-token-badge">--font-size-lg</span></td>
            <td>1.25rem / 20px</td>
            <td>1.40</td>
            <td><div style="font-size: var(--font-size-lg); font-weight: 600;">Cultura & Estrutura Organizacional</div></td>
          </tr>
          <tr>
            <td><span class="type-token-badge">--font-size-md</span></td>
            <td>1.125rem / 18px</td>
            <td>1.50</td>
            <td><div style="font-size: var(--font-size-md); color: var(--text-secondary);">Estratégia, liderança e cultura para transformar o potencial humano.</div></td>
          </tr>
          <tr>
            <td><span class="type-token-badge">--font-size-base</span></td>
            <td>1.00rem / 16px</td>
            <td>1.65</td>
            <td><p style="margin: 0;">Mais de 15 anos de experiência em desenvolvimento organizacional, liderança e cultura.</p></td>
          </tr>
          <tr>
            <td><span class="type-token-badge">--font-size-sm</span></td>
            <td>0.875rem / 14px</td>
            <td>1.50</td>
            <td><div style="font-size: var(--font-size-sm); color: var(--text-secondary);">Quero um diagnóstico gratuito →</div></td>
          </tr>
          <tr>
            <td><span class="type-token-badge">--font-size-xs</span></td>
            <td>0.75rem / 12px</td>
            <td>1.20</td>
            <td><span class="section-eyebrow" style="margin: 0;">CONSULTORIA ESTRATÉGICA EM PESSOAS</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- =========================================================================
       03. ESPAÇAMENTOS, RAIOS & SOMBRAS
       ========================================================================= -->
  <section class="section" id="espacamento">
    <div class="container container-wide">
      <div class="section-header">
        <span class="section-eyebrow">Seção 03</span>
        <h2 class="section-title">Espaçamento, Raios de Borda e Sombras</h2>
        <p class="section-subtitle">
          Escala de dimensões rigorosamente proporcional com base em múltiplos de 4px, acompanhada de raios de curvatura e elevação espacial.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr; gap: var(--space-8);">
        <!-- Régua de Espaçamentos -->
        <div class="comp-panel">
          <div class="comp-panel-header">
            <span class="comp-panel-title">Régua Escalar de Espaçamentos</span>
            <span class="badge">Grid 4px</span>
          </div>
          <div class="space-ruler">
            <div class="space-row"><div class="space-meta">--space-1 (4px)</div><div class="space-bar" style="width: 4px;"></div></div>
            <div class="space-row"><div class="space-meta">--space-2 (8px)</div><div class="space-bar" style="width: 8px;"></div></div>
            <div class="space-row"><div class="space-meta">--space-3 (12px)</div><div class="space-bar" style="width: 12px;"></div></div>
            <div class="space-row"><div class="space-meta">--space-4 (16px)</div><div class="space-bar" style="width: 16px;"></div></div>
            <div class="space-row"><div class="space-meta">--space-6 (24px)</div><div class="space-bar" style="width: 24px;"></div></div>
            <div class="space-row"><div class="space-meta">--space-8 (32px)</div><div class="space-bar" style="width: 32px;"></div></div>
            <div class="space-row"><div class="space-meta">--space-12 (48px)</div><div class="space-bar" style="width: 48px;"></div></div>
            <div class="space-row"><div class="space-meta">--space-16 (64px)</div><div class="space-bar" style="width: 64px;"></div></div>
            <div class="space-row"><div class="space-meta">--space-20 (80px)</div><div class="space-bar" style="width: 80px;"></div></div>
          </div>
        </div>

        <!-- Raios e Sombras -->
        <div class="comp-panel">
          <div class="comp-panel-header">
            <span class="comp-panel-title">Raios de Curvatura (Border Radius) & Elevação (Box Shadows)</span>
          </div>
          
          <div class="comp-demo-row" style="margin-bottom: var(--space-8);">
            <div style="padding: 16px; background: var(--bg-surface-subtle); border: 1px solid var(--border-default); border-radius: var(--radius-xs); font-size: 12px; font-weight: 600;">xs (4px)</div>
            <div style="padding: 16px; background: var(--bg-surface-subtle); border: 1px solid var(--border-default); border-radius: var(--radius-sm); font-size: 12px; font-weight: 600;">sm (8px)</div>
            <div style="padding: 16px; background: var(--bg-surface-subtle); border: 1px solid var(--border-default); border-radius: var(--radius-md); font-size: 12px; font-weight: 600;">md (12px)</div>
            <div style="padding: 16px; background: var(--bg-surface-subtle); border: 1px solid var(--border-default); border-radius: var(--radius-lg); font-size: 12px; font-weight: 600;">lg (16px)</div>
            <div style="padding: 16px; background: var(--bg-surface-subtle); border: 1px solid var(--border-default); border-radius: var(--radius-xl); font-size: 12px; font-weight: 600;">xl (20px)</div>
            <div style="padding: 16px; background: var(--bg-surface-subtle); border: 1px solid var(--border-default); border-radius: var(--radius-2xl); font-size: 12px; font-weight: 600;">2xl (28px)</div>
